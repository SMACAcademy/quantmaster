      "name": "Reading grouped bar charts",
      "description": "When several series share each category, match colours carefully via the legend before reading any value.",
      "sortOrder": 5
    }
  ],
  "formulas": [
    {
      "id": "bg-read-f",
      "topicId": "di-bar-graphs",
      "conceptId": "bg-reading",
      "title": "Reading a bar accurately",
      "prompt": "How do you read the exact value of a bar?",
      "formula": "Trace the top of the bar across to the value axis, using the gridlines to interpolate if needed",
      "variables": [],
      "explanation": "In a grouped chart, first match the bar's colour to its series in the legend — reading the right bar for the wrong series is the most common mistake.",
      "example": "A bar reaching halfway between the 40 and 60 gridlines represents about 50",
      "commonMistake": "Reading the wrong bar because its colour was not checked against the legend.",
      "applicationPrompt": "How do you find which series a bar belongs to in a grouped bar chart?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "bg-share-f",
      "topicId": "di-bar-graphs",
      "conceptId": "bg-share",
      "title": "Share of the total",
      "prompt": "How do you express one bar as a share of a total?",
      "formula": "Share % = (Value ÷ Total of that category) × 100",
      "variables": [],
      "explanation": "Be sure the \"total\" is the right one — usually the sum of all series within the same category (e.g. the same month).",
      "example": "Store A = 40, month total = 100: share = 40 ÷ 100 × 100 = 40%",
      "commonMistake": "Dividing by the total across all categories instead of just the one being asked about.",
      "applicationPrompt": "Store A sold 40 out of a monthly total of 100. What is its share?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "bg-growth-f",
      "topicId": "di-bar-graphs",
      "conceptId": "bg-growth",
      "title": "Growth between two bars",
      "prompt": "How do you find the percentage growth between two bars of the same series?",
      "formula": "Growth % = (Later value − Earlier value) ÷ Earlier value × 100",
      "variables": [],
      "explanation": "The earlier bar is always the denominator, even if the question is phrased with the later one first.",
      "example": "50 → 65: growth = 15 ÷ 50 × 100 = 30%",
      "commonMistake": "Dividing by the later value instead of the earlier one.",
      "applicationPrompt": "A bar rises from 50 to 65. What is the percentage growth?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "bg-sc-threshold",
      "topicId": "di-bar-graphs",
      "conceptId": "bg-growth",
      "kind": "shortcut",
      "title": "\"More than x%?\" without dividing",
      "prompt": "A question asks whether growth exceeded x%. What is the fastest test?",
      "formula": "Compare the new value with old × (1 + x/100)",
      "variables": [],
      "explanation": "One multiplication answers a yes/no question; the exact percentage is not needed.",
      "example": "Did sales rise by more than 20% from 340 to 420? 340 × 1.2 = 408 < 420, so yes.",
      "commonMistake": "Working out the exact percentage for every bar.",
      "applicationPrompt": "In which years did production rise by more than 15% if it went 260 → 300 → 340?",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    }
  ],

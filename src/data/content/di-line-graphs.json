  "formulas": [
    {
      "id": "lng-read-f",
      "topicId": "di-line-graphs",
      "conceptId": "lng-reading",
      "title": "Reading a line graph",
      "prompt": "How do you read the value of a line at a given category?",
      "formula": "Find the category on the x-axis, move up to the line, then across to the value axis",
      "variables": [],
      "explanation": "Each marked point represents an exact value; do not estimate between labelled categories unless the question asks for a trend, not a value.",
      "example": "The point above 2021 at height 30 means the value in 2021 is 30",
      "commonMistake": "Reading the wrong series when two lines are close together.",
      "applicationPrompt": "How do you find the exact value at a labelled point on a line graph?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "lng-growth-f",
      "topicId": "di-line-graphs",
      "conceptId": "lng-growth",
      "title": "Growth between two points",
      "prompt": "How do you find the percentage change between two points on a line?",
      "formula": "Growth % = (Later value − Earlier value) ÷ Earlier value × 100",
      "variables": [],
      "explanation": "A negative result means a decline; state it as a fall of that percentage rather than a negative growth.",
      "example": "30 → 27: change = (27−30) ÷ 30 × 100 = −10%, a 10% decline",
      "commonMistake": "Dividing by the later value instead of the earlier one.",
      "applicationPrompt": "A line falls from 30 to 27. What is the percentage change?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "lng-compare-f",
      "topicId": "di-line-graphs",
      "conceptId": "lng-compare",
      "title": "Comparing two lines",
      "prompt": "How do you find where two lines are closest, or where one overtakes the other?",
      "formula": "Compute the difference between the two lines at every point; the smallest |difference| is where they are closest, and a sign change marks where one overtakes the other",
      "variables": [],
      "explanation": "Two lines \"crossing\" between two labelled points means the sign of the difference flips between those two points.",
      "example": "If X−Y is negative in 2020 and positive in 2021, the lines crossed somewhere between those years",
      "commonMistake": "Judging distance visually rather than computing the actual differences.",
      "applicationPrompt": "How do you find the year where two lines on a graph are closest together?",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "lng-sc-steep-vs-percent",
      "topicId": "di-line-graphs",
      "conceptId": "lng-growth",
      "kind": "shortcut",
      "title": "Steepest line is not the biggest percentage",
      "prompt": "Which segment of a line graph has the greatest percentage growth?",
      "formula": "Steepest segment = largest change in value\nLargest % change = change ÷ starting value: check low starting points",
      "variables": [],
      "explanation": "The same rise is a bigger percentage on a smaller base.",
      "example": "50 → 75 is +25 but +50%; 200 → 240 is +40 but only +20%.",
      "commonMistake": "Picking the steepest segment when the question asks for percentage growth.",
      "applicationPrompt": "Which grew faster in percentage terms: 80 → 100 or 300 → 360?",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    }
  ],

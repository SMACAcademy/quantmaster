      "learningStage": "independent",
      "type": "numerical_input",
      "question": "Solve for x: 3x + 7 = 22.",
      "answer": {
        "value": 5,
        "tolerance": 0
      },
      "explanation": "Subtract 7 from both sides: 3x = 15. Divide by 3: x = 5.",
      "solutionSteps": [
        "3x = 22 − 7 = 15.",
        "x = 15 ÷ 3 = 5."

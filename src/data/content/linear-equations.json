  "formulas": [
    {
      "id": "le-balance-f",
      "topicId": "linear-equations",
      "conceptId": "le-onevar",
      "title": "Balancing an equation",
      "prompt": "How do you solve ax + b = c for x?",
      "formula": "ax + b = c  →  x = (c − b) / a",
      "variables": [],
      "explanation": "Whatever you do to one side of an equation, you must do to the other, to keep both sides equal.",
      "example": "3x + 7 = 22  →  3x = 15  →  x = 5",
      "commonMistake": "Moving a term across the equals sign without changing its sign.",
      "applicationPrompt": "Solve 3x + 7 = 22.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "le-bothsides-f",
      "topicId": "linear-equations",
      "conceptId": "le-onevar",
      "title": "Variable on both sides",
      "prompt": "How do you solve an equation with x on both sides?",
      "formula": "Collect all x terms on one side and all constants on the other",
      "variables": [],
      "explanation": "Subtract the smaller x-term from both sides first, then isolate x as usual.",
      "example": "5x − 3 = 2x + 9  →  3x = 12  →  x = 4",
      "commonMistake": "Combining terms from different sides without moving them properly.",
      "applicationPrompt": "Solve 5x − 3 = 2x + 9.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "le-clear-f",
      "topicId": "linear-equations",
      "conceptId": "le-brackets",
      "title": "Clearing brackets and fractions",
      "prompt": "How do you solve an equation with brackets or fractions?",
      "formula": "Expand every bracket first; multiply every term by the LCM of the denominators to clear fractions",
      "variables": [],
      "explanation": "Once brackets and fractions are gone, the equation becomes a simple balancing problem.",
      "example": "2(x + 3) = 16  →  2x + 6 = 16  →  x = 5",
      "commonMistake": "Multiplying only some terms by the LCM.",
      "applicationPrompt": "Solve 2(x + 3) = 16.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "le-word-f",
      "topicId": "linear-equations",
      "conceptId": "le-word",
      "title": "Setting up word problems",
      "prompt": "How do you turn a word problem into an equation?",
      "formula": "Let the unknown be x; translate each phrase into algebra; set the two sides equal",
      "variables": [],
      "explanation": "\"5 more than a number\" is x + 5; \"twice a number\" is 2x; combine according to the sentence.",
      "example": "\"5 more than twice a number is 17\" → 2x + 5 = 17 → x = 6",
      "commonMistake": "Reversing the order, writing 5 + 2x as 2(x + 5).",
      "applicationPrompt": "Five more than twice a number is 17. Find the number.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "le-age-f",
      "topicId": "linear-equations",
      "conceptId": "le-age",
      "title": "Age problems",
      "prompt": "How do you handle ages \"in the future\" or \"in the past\"?",
      "formula": "If a person is currently x years old, they will be x + k in k years, and were x − k, k years ago",
      "variables": [],
      "explanation": "The same shift k applies to everyone in the problem at the same time.",
      "example": "A father is 3 times his son’s age; in 5 years he will be 2.5 times. Set up: F = 3S and F + 5 = 2.5(S + 5).",
      "commonMistake": "Adding the shift to only one person’s age.",
      "applicationPrompt": "Set up equations for a father 3 times his son’s current age.",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "le-sc-options",
      "topicId": "linear-equations",
      "conceptId": "le-check",
      "kind": "shortcut",
      "title": "Try the options",
      "prompt": "In a multiple-choice equation, what is often faster than solving it?",
      "formula": "Substitute each option; the one that balances is the answer.\nStart with the middle option.",
      "variables": [],
      "explanation": "Checking a value takes one line, while solving may take several. Starting in the middle tells you which way to go.",
      "example": "3x/4 + 5 = 17, options 12, 14, 16, 18: x = 16 gives 12 + 5 = 17.",
      "commonMistake": "Stopping at an option that only nearly balances because of rounding.",
      "applicationPrompt": "(x + 4)/3 = (x − 2)/2. Options: 8, 12, 14, 16.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    },
    {
      "id": "le-sc-middle",
      "topicId": "linear-equations",
      "conceptId": "le-word",
      "kind": "shortcut",
      "title": "Consecutive numbers: start from the middle",
      "prompt": "How do you find consecutive numbers from their sum quickly?",
      "formula": "Middle number = Sum ÷ how many numbers\n(for an even count, the average of the two middle ones)",
      "variables": [],
      "explanation": "Evenly spaced numbers average to their middle value, so dividing the sum gives it at once.",
      "example": "Three consecutive numbers add to 72: middle 24, so 23, 24, 25.",
      "commonMistake": "Writing x + (x + 1) + (x + 2) and solving when one division is enough.",
      "applicationPrompt": "Five consecutive odd numbers add to 125. Find the largest.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    }
  ],

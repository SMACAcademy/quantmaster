  "formulas": [
    {
      "id": "dc-compare-f",
      "topicId": "decimals",
      "conceptId": "dc-compare",
      "title": "Comparing",
      "prompt": "How do you compare 0.5, 0.45 and 0.405?",
      "formula": "Pad with zeros to equal length, then compare as whole numbers\n0.500, 0.450, 0.405",
      "variables": [],
      "explanation": "The number of digits after the point does not make a decimal larger; the first differing digit does.",
      "example": "0.5 = 0.500 > 0.450 > 0.405",
      "commonMistake": "Thinking the number with more digits is larger.",
      "applicationPrompt": "Which is greater: 0.5 or 0.45?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "dc-mult-f",
      "topicId": "decimals",
      "conceptId": "dc-ops",
      "title": "Multiplication",
      "prompt": "How do you multiply decimals?",
      "formula": "Ignore the points and multiply as whole numbers.\nDecimal places in the answer = places in the first + places in the second",
      "variables": [],
      "explanation": "Each decimal place is a division by 10, so the places add.",
      "example": "2.5 × 0.04 → 25 × 4 = 100 → 3 places → 0.100 = 0.1",
      "commonMistake": "Counting decimal places in only one of the numbers.",
      "applicationPrompt": "Find 0.3 × 0.4.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "dc-div-f",
      "topicId": "decimals",
      "conceptId": "dc-ops",
      "title": "Division",
      "prompt": "How do you divide by a decimal?",
      "formula": "Multiply the dividend and divisor by the same power of 10 until the divisor is whole",
      "variables": [],
      "explanation": "Scaling both numbers by the same factor leaves the quotient unchanged.",
      "example": "6.3 ÷ 0.09 = 630 ÷ 9 = 70",
      "commonMistake": "Shifting only the divisor.",
      "applicationPrompt": "Find 6.3 ÷ 0.09.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "dc-conv-f",
      "topicId": "decimals",
      "conceptId": "dc-convert",
      "kind": "shortcut",
      "title": "Common conversions",
      "prompt": "Which fraction–decimal pairs are worth knowing?",
      "formula": "1/2 = 0.5, 1/4 = 0.25, 3/4 = 0.75, 1/5 = 0.2\n1/8 = 0.125, 3/8 = 0.375, 5/8 = 0.625, 1/16 = 0.0625",
      "variables": [],
      "explanation": "Knowing these saves long division and makes percentages instant.",
      "example": "3/8 = 0.375",
      "commonMistake": "Rounding 0.375 to 0.38 when an exact value is needed.",
      "applicationPrompt": "Write 3/8 as a decimal.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "dc-recurring-f",
      "topicId": "decimals",
      "conceptId": "dc-recurring",
      "kind": "shortcut",
      "title": "Recurring decimals",
      "prompt": "How do you turn a pure recurring decimal into a fraction?",
      "formula": "0.aaa… = a/9\n0.ababab… = ab/99\n0.abcabc… = abc/999",
      "variables": [],
      "explanation": "A block of n repeating digits equals that block over n nines, then simplify.",
      "example": "0.3636… = 36/99 = 4/11",
      "commonMistake": "Dividing by 100 instead of 99.",
      "applicationPrompt": "Write 0.3636… as a fraction in lowest terms.",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    }
  ],

    {
      "id": "decimals-q-011",
      "topicId": "decimals",
      "conceptId": "dc-recurring",
      "levelId": "decimals-level-4",
      "difficulty": "complex",
      "learningStage": "challenge",
      "type": "numerical_input",
      "question": "The sum 0.4545… + 0.2222… equals 0.ababab… What is a + b?",
      "answer": {
        "value": 13,
        "tolerance": 0
      },
      "explanation": "0.4545… = 45/99 = 5/11 and 0.2222… = 2/9. Over 99: 45/99 + 22/99 = 67/99 = 0.6767…, so a = 6, b = 7 and a + b = 13.",
      "solutionSteps": [
        "0.4545… = 45/99.",
        "0.2222… = 22/99.",
        "Sum = 67/99 = 0.6767….",
        "6 + 7 = 13."
      ],
      "formulaIds": [
        "dc-recurring-f"
      ],
      "method": "Convert each to a fraction over 99 and add.",
      "hints": [
        {
          "level": 1,
          "text": "0.2222… = 2/9 = 22/99."
        },
        {
          "level": 2,
          "text": "Add over the common denominator 99."
        }

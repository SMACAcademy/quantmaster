  "formulas": [
    {
      "id": "ai-squares-f",
      "topicId": "algebraic-identities",
      "conceptId": "ai-squares",
      "title": "Square of a sum or difference",
      "prompt": "What do (a + b)² and (a − b)² expand to?",
      "formula": "(a + b)² = a² + 2ab + b²\n(a − b)² = a² − 2ab + b²",
      "variables": [],
      "explanation": "The middle term 2ab is easy to forget; only its sign changes between the two identities.",
      "example": "(x + 5)² = x² + 10x + 25",
      "commonMistake": "Forgetting the middle term 2ab entirely.",
      "applicationPrompt": "Expand (x + 5)².",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ai-diffsquares-f",
      "topicId": "algebraic-identities",
      "conceptId": "ai-diffsquares",
      "title": "Difference of squares",
      "prompt": "How does a² − b² factorise?",
      "formula": "a² − b² = (a + b)(a − b)",
      "variables": [],
      "explanation": "This turns a subtraction of two squares into a single product, which is often much easier to compute or factorise further.",
      "example": "x² − 64 = (x + 8)(x − 8)",
      "commonMistake": "Writing a² − b² as (a − b)², which loses the cross term.",
      "applicationPrompt": "Factorise x² − 64.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ai-cubes-f",
      "topicId": "algebraic-identities",
      "conceptId": "ai-cubes",
      "title": "Cube of a sum or difference",
      "prompt": "What do (a + b)³ and (a − b)³ expand to?",
      "formula": "(a + b)³ = a³ + 3a²b + 3ab² + b³\n(a − b)³ = a³ − 3a²b + 3ab² − b³",
      "variables": [],
      "explanation": "The signs alternate in the difference version; the coefficients 1, 3, 3, 1 stay the same in both.",
      "example": "(x + 2)³ = x³ + 6x² + 12x + 8",
      "commonMistake": "Using only two terms, as if cubing worked like squaring.",
      "applicationPrompt": "Expand (x + 2)³.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ai-sumdiffcubes-f",
      "topicId": "algebraic-identities",
      "conceptId": "ai-sumdiffcubes",
      "title": "Sum and difference of cubes",
      "prompt": "How do a³ + b³ and a³ − b³ factorise?",
      "formula": "a³ + b³ = (a + b)(a² − ab + b²)\na³ − b³ = (a − b)(a² + ab + b²)",
      "variables": [],
      "explanation": "The linear factor matches the sign of the original expression; the quadratic factor always has the opposite sign in its middle term.",
      "example": "x³ − 27 = (x − 3)(x² + 3x + 9)",
      "commonMistake": "Getting the sign of the middle term ab wrong in the quadratic factor.",
      "applicationPrompt": "Factorise x³ − 27.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ai-apply-f",
      "topicId": "algebraic-identities",
      "conceptId": "ai-apply",
      "kind": "shortcut",
      "title": "Using identities on numbers",
      "prompt": "How do identities speed up arithmetic like 105² or 97 × 103?",
      "formula": "Write the number as (round number ± small amount), then apply the matching identity",
      "variables": [],
      "explanation": "Once the number is split this way, the identity replaces long multiplication with a couple of small computations.",
      "example": "105² = (100 + 5)² = 10,000 + 1,000 + 25 = 11,025\n97 × 103 = (100 − 3)(100 + 3) = 10,000 − 9 = 9,991",
      "commonMistake": "Splitting the number incorrectly, or forgetting the middle term.",
      "applicationPrompt": "Compute 105² using an identity.",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "ai-sc-zero-sum-cubes",
      "topicId": "algebraic-identities",
      "conceptId": "ai-cubes",
      "kind": "shortcut",
      "title": "When a + b + c = 0",
      "prompt": "a + b + c = 0. What is a³ + b³ + c³?",
      "formula": "If a + b + c = 0, then a³ + b³ + c³ = 3abc",
      "variables": [],
      "explanation": "It comes from a³ + b³ + c³ − 3abc = (a + b + c)(a² + b² + c² − ab − bc − ca), whose first factor is zero.",
      "example": "5³ + (−2)³ + (−3)³ = 125 − 8 − 27 = 90 = 3 × 5 × (−2) × (−3).",
      "commonMistake": "Using it when the sum is not zero.",
      "applicationPrompt": "Find (x − y)³ + (y − z)³ + (z − x)³ in factored form.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    },
    {
      "id": "ai-sc-x-plus-reciprocal",
      "topicId": "algebraic-identities",
      "conceptId": "ai-squares",
      "kind": "shortcut",
      "title": "x + 1/x given",
      "prompt": "You know x + 1/x = k. What are x² + 1/x² and x³ + 1/x³?",
      "formula": "x² + 1/x² = k² − 2\nx³ + 1/x³ = k³ − 3k",
      "variables": [],
      "explanation": "Square or cube x + 1/x; the cross terms are constants because x × 1/x = 1.",
      "example": "x + 1/x = 3: x² + 1/x² = 9 − 2 = 7 and x³ + 1/x³ = 27 − 9 = 18.",
      "commonMistake": "Writing x² + 1/x² = k², forgetting the 2 from the middle term.",
      "applicationPrompt": "If x − 1/x = 4, find x² + 1/x² (hint: the sign of the middle term changes).",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    }
  ],

      "difficulty": "easy",
      "learningStage": "independent",
      "type": "single_choice",
      "question": "What is (x + 5)² expanded?",
      "options": [
        {
          "id": "a",
          "text": "x² + 10x + 25"
        },
        {
          "id": "b",
          "text": "x² + 25"
        },
        {
          "id": "c",
          "text": "x² + 5x + 25"
        },
        {
          "id": "d",
          "text": "x² + 10x + 10"
        }
      ],
      "correctAnswer": [
        "a"
      ],
      "explanation": "Using (a + b)² = a² + 2ab + b² with a = x, b = 5: x² + 10x + 25.",

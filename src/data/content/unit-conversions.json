{
  "topicId": "unit-conversions",
  "concepts": [
    {
      "id": "uc-metric",
      "topicId": "unit-conversions",
      "name": "Length, mass and volume",
      "description": "Metric units differ by powers of ten: 1 km = 1,000 m, 1 kg = 1,000 g, 1 L = 1,000 mL.",
      "sortOrder": 1
    },
    {
      "id": "uc-area-volume",
      "topicId": "unit-conversions",
      "name": "Areas and volumes",
      "description": "Area factors are the square of the length factor; volume factors are the cube.",
      "sortOrder": 2
    },
    {
      "id": "uc-time-speed",
      "topicId": "unit-conversions",
      "name": "Time and speed",
      "description": "Convert hours, minutes and seconds carefully; km/hr to m/s is × 5/18.",
      "sortOrder": 3
    },
    {
      "id": "uc-rates",
      "topicId": "unit-conversions",
      "name": "Compound rates",
      "description": "Convert the top unit and the bottom unit separately, then combine.",
      "sortOrder": 4
    },
    {
      "id": "uc-word",
      "topicId": "unit-conversions",
      "name": "Conversions in word problems",
      "description": "Convert everything to one unit before dividing or multiplying.",
      "sortOrder": 5
    }
  ],
  "formulas": [
    {
      "id": "uc-metric-f",
      "topicId": "unit-conversions",
      "conceptId": "uc-metric",
      "title": "Metric ladder",
      "prompt": "What are the basic metric conversions?",
      "formula": "1 km = 1,000 m; 1 m = 100 cm = 1,000 mm\n1 kg = 1,000 g; 1 tonne = 1,000 kg; 1 quintal = 100 kg\n1 L = 1,000 mL = 1,000 cm³",
      "variables": [],
      "explanation": "Going to a smaller unit multiplies (more of them); going to a larger unit divides.",
      "example": "3.5 km = 3,500 m; 4,500 g = 4.5 kg",
      "commonMistake": "Multiplying when you should divide, or vice versa.",
      "applicationPrompt": "Convert 2.5 L into millilitres.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "uc-square-f",
      "topicId": "unit-conversions",
      "conceptId": "uc-area-volume",
      "title": "Squares and cubes",
      "prompt": "How do area and volume factors relate to length factors?",
      "formula": "1 m = 100 cm → 1 m² = 100² = 10,000 cm² → 1 m³ = 100³ = 1,000,000 cm³\n1 hectare = 10,000 m²; 1 km² = 100 hectares; 1 m³ = 1,000 L",
      "variables": [],
      "explanation": "Area has two lengths, so the factor is squared; volume has three, so it is cubed.",
      "example": "1 m² = 10,000 cm²",
      "commonMistake": "Using the linear factor (100) for an area.",
      "applicationPrompt": "How many square centimetres are in one square metre?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "uc-time-f",
      "topicId": "unit-conversions",
      "conceptId": "uc-time-speed",
      "title": "Time and speed",
      "prompt": "How do you convert between hours, minutes and seconds, and between km/hr and m/s?",
      "formula": "1 hr = 60 min = 3,600 s\nkm/hr → m/s: × 5/18\nm/s → km/hr: × 18/5",
      "variables": [],
      "explanation": "Speed is distance ÷ time, so convert both: 1 km/hr = 1,000 m ÷ 3,600 s = 5/18 m/s.",
      "example": "72 km/hr = 72 × 5/18 = 20 m/s",
      "commonMistake": "Swapping 5/18 and 18/5.",
      "applicationPrompt": "Convert 72 km/hr into m/s.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "uc-rate-f",
      "topicId": "unit-conversions",
      "conceptId": "uc-rates",
      "title": "Compound rates",
      "prompt": "How do you convert a rate such as litres per minute into m³ per hour?",
      "formula": "Convert the top unit and the bottom unit separately, multiplying by conversion fractions that equal 1",
      "variables": [],
      "explanation": "Each conversion fraction (like 60 min / 1 hr) equals one, so multiplying by it changes the units but not the quantity.",
      "example": "12 L/min × 60 min/hr ÷ 1,000 L/m³ = 0.72 m³/hr",
      "commonMistake": "Converting only one of the two units.",
      "applicationPrompt": "A tap delivers 12 litres per minute. How many cubic metres is that per hour?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "uc-word-f",
      "topicId": "unit-conversions",
      "conceptId": "uc-word",
      "title": "Unit sanity check",
      "prompt": "How do you avoid unit slips in word problems?",
      "formula": "Write every quantity with its unit; cancel units to check the result has the unit you want",
      "variables": [],
      "explanation": "If a result comes out in the wrong unit, a conversion is missing.",
      "example": "Tiles: area (cm²) ÷ tile area (cm²) = a pure number",
      "commonMistake": "Dividing metres by centimetres without converting.",
      "applicationPrompt": "How many 20 cm × 30 cm tiles cover a 6 m × 4 m floor?",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "uc-sc-3-6",
      "topicId": "unit-conversions",
      "conceptId": "uc-time-speed",
      "kind": "shortcut",
      "title": "m/s and km/h with 3.6",
      "prompt": "What single number converts between m/s and km/h?",
      "formula": "m/s × 3.6 = km/h\nkm/h ÷ 3.6 = m/s",
      "variables": [],
      "explanation": "1 m/s is 3,600 m an hour, which is 3.6 km/h. It is the same as × 18/5.",
      "example": "25 m/s = 90 km/h. 54 km/h = 15 m/s.",
      "commonMistake": "Multiplying when going from km/h to m/s. The m/s figure is always the smaller.",
      "applicationPrompt": "A sprinter runs 100 m in 10 s. What is that in km/h?",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    }
  ],

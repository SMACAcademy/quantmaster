  "formulas": [
    {
      "id": "di-share",
      "topicId": "di-tables",
      "conceptId": "di-totals",
      "title": "Share of the total",
      "prompt": "How do you express one entry as a share of its total?",
      "formula": "Share % = (Entry ÷ Total) × 100",
      "variables": [],
      "explanation": "Be precise about which total: the row, the column, or the grand total. DI questions deliberately offer all three.",
      "example": "Product A 2023 = 180, total 2023 = 450\nShare = 180 ÷ 450 = 40%",
      "commonMistake": "Dividing by the wrong total — usually the grand total instead of the year's total.",
      "applicationPrompt": "Product A sold 180 of a 450 total. What is its share?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "di-growth",
      "topicId": "di-tables",
      "conceptId": "di-change",
      "title": "Growth between periods",
      "prompt": "How do you express the change between two years in a table?",
      "formula": "Growth % = (Later − Earlier) ÷ Earlier × 100",
      "variables": [],
      "explanation": "The EARLIER value is always the denominator. This is percentage change applied to table data.",
      "example": "300 → 360\nGrowth = 60 ÷ 300 = 20%",
      "commonMistake": "Dividing by the later value, which understates the growth.",
      "applicationPrompt": "Sales rose from 300 to 360. What is the growth percentage?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "di-points-rule",
      "topicId": "di-tables",
      "conceptId": "di-points",
      "title": "Points vs percentage",
      "prompt": "A share moves from 26.7% to 33.3%. Is that a rise of 6.6 or of 25?",
      "formula": "Percentage points = new% − old%\nPercentage change = (new% − old%) ÷ old% × 100",
      "variables": [],
      "explanation": "Both are correct answers to different questions. Read whether the question says 'percentage points' or 'percent increase'.",
      "example": "26.7% → 33.3%\n= 6.6 percentage points\n= a 25% increase in the share",
      "commonMistake": "Reporting a points change as a percentage increase.",
      "applicationPrompt": "A share rose from 26.7% to 33.3%. How many percentage points is that?",
      "tags": [
        "trap",
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "dt-adv-cross-f",
      "topicId": "di-tables",
      "conceptId": "dt-adv-ratio-compare",
      "title": "Cross-multiplying fractions",
      "prompt": "How can you tell which of a/b and c/d is larger without dividing?",
      "formula": "a/b > c/d exactly when a × d > b × c (b and d positive)",
      "variables": [],
      "explanation": "Multiplying both fractions by b × d keeps the order and removes the division.",
      "example": "1260/3600 vs 1560/4800: 1260 × 4800 = 6,048,000 > 1560 × 3600 = 5,616,000, so 1260/3600 is larger",
      "commonMistake": "Comparing only the numerators (1560 > 1260) and ignoring the different totals.",
      "applicationPrompt": "Which qualifying rate is higher: 1260 of 3600, or 1560 of 4800?",
      "tags": [
        "advanced"
      ],
      "difficulty": "complex"
    },
    {
      "id": "dt-adv-growth-f",
      "topicId": "di-tables",
      "conceptId": "dt-adv-growth-compare",
      "title": "Ranking growth rates",
      "prompt": "How do you rank rows by percentage growth?",
      "formula": "Growth factor = new ÷ old; the largest factor has the largest percentage growth",
      "variables": [],
      "explanation": "Percentage growth = (new ÷ old − 1) × 100, so ranking the factors ranks the percentages. The absolute change (new − old) can rank differently.",
      "example": "X: 300 ÷ 240 = 1.25; Y: 480 ÷ 400 = 1.20; Z: 195 ÷ 150 = 1.30, so Z grew fastest though Y rose most in amount",
      "commonMistake": "Picking the row with the largest difference as the fastest-growing.",
      "applicationPrompt": "Revenue rose from 240 to 300, 400 to 480, and 150 to 195. Which grew fastest in percentage terms?",
      "tags": [
        "advanced"
      ],
      "difficulty": "complex"
    },
    {
      "id": "di-sc-assumed-average",
      "topicId": "di-tables",
      "conceptId": "di-totals",
      "kind": "shortcut",
      "title": "Averaging a column fast",
      "prompt": "How do you average a column of close numbers quickly?",
      "formula": "Pick a round value near the middle,\nadd the differences, divide, adjust",
      "variables": [],
      "explanation": "The differences are small, so the arithmetic stays in your head.",
      "example": "412, 398, 405, 395: assume 400; differences +12, −2, +5, −5 sum to +10, so the average is 400 + 2.5 = 402.5.",
      "commonMistake": "Dividing the total of the differences by 1 instead of by the number of values.",
      "applicationPrompt": "Average 1,206, 1,189, 1,215 and 1,198.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    }
  ],
  "levels": [
    {
      "id": "di-tables-level-0",
      "topicId": "di-tables",
      "order": 0,
      "title": "Reading Before Calculating",
      "description": "DI rewards accurate reading far more than fast arithmetic.",
      "type": "concept",
      "difficulty": "easy",
      "estimatedMinutes": 5,
      "prerequisiteLevelIds": [],
      "conceptIds": [
        "di-read",
        "di-totals"
      ],
      "xpReward": 20,
      "lesson": {
        "blocks": [
          {
            "type": "text",
            "title": "Three checks before any arithmetic",
            "body": "1. What are the units? '₹ lakh' and '₹' are not the same answer.\n2. Which row and which column does the question actually ask about?\n3. Which total does it want — the row, the column, or everything?\n\nMost lost DI marks come from failing one of these, not from the calculation."
          },
          {
            "type": "formula",
            "title": "The two workhorses",
            "body": "Share % = Entry ÷ Total × 100\nGrowth % = (Later − Earlier) ÷ Earlier × 100",
            "caption": "DI is almost entirely percentages and ratios applied under time pressure."
          },
          {
            "type": "callout",
            "tone": "warning",
            "body": "'Percentage points' and 'percent increase' are different questions. A share moving from 26.7% to 33.3% is up 6.6 percentage points, which is a 25% increase in the share itself."
          },
          {
            "type": "simulation",
            "simulationId": "di-tables"
          },
          {
            "type": "check",
            "questionId": "di-tables-q-001"
          },
          {
            "type": "text",
            "title": "Approximate deliberately",
            "body": "When options are far apart, round: 180/450 is 'a bit under half' — 40%. Reserve exact arithmetic for questions where two options are close together."
          },
          {
            "type": "check",
            "questionId": "di-tables-q-020"
          }
        ]
      }
    },

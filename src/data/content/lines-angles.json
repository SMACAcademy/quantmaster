{
  "topicId": "lines-angles",
  "concepts": [
    {
      "id": "la-types",
      "topicId": "lines-angles",
      "name": "Angle facts",
      "description": "Angles on a straight line sum to 180°; angles all the way around a point sum to 360°.",
      "sortOrder": 1
    },
    {
      "id": "la-pairs",
      "topicId": "lines-angles",
      "name": "Linear pairs",
      "description": "Two adjacent angles that together form a straight line are supplementary — they add to 180°.",
      "sortOrder": 2
    },
    {
      "id": "la-vertical",
      "topicId": "lines-angles",
      "name": "Vertically opposite angles",
      "description": "When two lines cross, the angles directly opposite each other are always equal.",
      "sortOrder": 3
    },
    {
      "id": "la-parallel",
      "topicId": "lines-angles",
      "name": "Angles formed by a transversal",
      "description": "A line crossing two parallel lines creates equal corresponding and alternate angles, and co-interior angles that sum to 180°.",
      "sortOrder": 4
    },
    {
      "id": "la-solve",
      "topicId": "lines-angles",
      "name": "Setting up angle equations",
      "description": "Translate an angle relationship (vertical, linear pair, co-interior) into an equation and solve for the unknown.",
      "sortOrder": 5
    }
  ],
  "formulas": [
    {
      "id": "la-straight-f",
      "topicId": "lines-angles",
      "conceptId": "la-types",
      "title": "Angles on a straight line",
      "prompt": "What do angles on a straight line add up to?",
      "formula": "Angles on a straight line sum to 180°",
      "variables": [],
      "explanation": "Any number of angles sitting side by side along one straight line always total 180°.",
      "example": "If one angle on a line is 130°, the other is 180 − 130 = 50°",
      "commonMistake": "Assuming angles on a line sum to 360° (that is for angles all the way around a point).",
      "applicationPrompt": "One angle on a straight line is 130°. What is the other?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "la-vertical-f",
      "topicId": "lines-angles",
      "conceptId": "la-vertical",
      "title": "Vertically opposite angles",
      "prompt": "What is true about the angles formed when two straight lines cross?",
      "formula": "Vertically opposite angles are equal",
      "variables": [],
      "explanation": "Two crossing lines create two pairs of equal angles, directly across from each other through the crossing point.",
      "example": "If one angle at the crossing is 130°, the angle directly opposite it is also 130°",
      "commonMistake": "Confusing vertically opposite angles (equal) with adjacent angles (supplementary).",
      "applicationPrompt": "Two lines cross, and one angle is 130°. What is the angle vertically opposite it?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "la-parallel-f",
      "topicId": "lines-angles",
      "conceptId": "la-parallel",
      "title": "Transversal angle relationships",
      "prompt": "What angle relationships appear when a transversal crosses two parallel lines?",
      "formula": "Corresponding angles are equal.\nAlternate angles are equal.\nCo-interior (same-side interior) angles sum to 180°.",
      "variables": [],
      "explanation": "Corresponding angles sit in matching positions at each crossing; co-interior angles sit between the parallel lines, on the same side of the transversal.",
      "example": "If a corresponding angle is 65°, the matching corresponding angle at the other crossing is also 65°; the co-interior angle there is 180 − 65 = 115°",
      "commonMistake": "Treating co-interior angles as equal instead of supplementary.",
      "applicationPrompt": "A corresponding angle is 65°. What is the co-interior angle at the other line?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "la-sc-bend",
      "topicId": "lines-angles",
      "conceptId": "la-parallel",
      "kind": "shortcut",
      "title": "A bend between parallel lines",
      "prompt": "A path bends between two parallel lines. How do you find the angle at the bend?",
      "formula": "Angle at the bend = sum of the two angles it makes with the parallel lines",
      "variables": [],
      "explanation": "Draw a third parallel line through the bend: it splits the angle into two alternate angles.",
      "example": "The path makes 40° with the top line and 30° with the bottom line: the bend is 70°.",
      "commonMistake": "Subtracting the angles instead of adding them.",
      "applicationPrompt": "Angles of 55° and 35° at two parallel lines meet at a bend. Find it.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    },
    {
      "id": "la-sc-bisectors",
      "topicId": "lines-angles",
      "conceptId": "la-pairs",
      "kind": "shortcut",
      "title": "Bisectors of a linear pair",
      "prompt": "Two angles on a straight line are each bisected. What angle do the bisectors make?",
      "formula": "Always 90°",
      "variables": [],
      "explanation": "The halves add to half of 180°.",
      "example": "130° and 50°: halves 65° and 25° add to 90°.",
      "commonMistake": "Working out each half separately and not noticing the answer never changes.",
      "applicationPrompt": "Angles of 112° and 68° lie on a line. Find the angle between their bisectors.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    }
  ],

    }
  ],
  "formulas": [
    {
      "id": "fr-compare-f",
      "topicId": "fractions",
      "conceptId": "fr-compare",
      "title": "Comparing",
      "prompt": "How do you tell which of a/b and c/d is larger?",
      "formula": "a/b > c/d  ⇔  a × d > c × b  (b, d > 0)",
      "variables": [],
      "explanation": "Cross-multiplying is the same as putting both over the common denominator b × d.",
      "example": "3/4 vs 5/8: 3 × 8 = 24 and 5 × 4 = 20 → 3/4 is larger",
      "commonMistake": "Comparing numerators and denominators separately.",
      "applicationPrompt": "Which is larger, 3/4 or 5/8?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "fr-add-f",
      "topicId": "fractions",
      "conceptId": "fr-operations",
      "title": "Adding and subtracting",
      "prompt": "How do you add or subtract fractions?",
      "formula": "a/b ± c/d = (a × d ± c × b) ÷ (b × d)\n(or use the LCM of b and d)",
      "variables": [],
      "explanation": "The denominators must match before the numerators can be combined.",
      "example": "1/2 + 1/3 = 3/6 + 2/6 = 5/6",
      "commonMistake": "Adding numerators and denominators separately: 1/2 + 1/3 = 2/5.",
      "applicationPrompt": "Find 3/4 − 2/5.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "fr-muldiv-f",
      "topicId": "fractions",
      "conceptId": "fr-operations",
      "title": "Multiplying and dividing",
      "prompt": "How do you multiply and divide fractions?",
      "formula": "a/b × c/d = ac / bd\na/b ÷ c/d = a/b × d/c = ad / bc",
      "variables": [],
      "explanation": "Multiplication goes straight across. Dividing by a fraction is multiplying by its reciprocal. Cancel common factors first to keep numbers small.",
      "example": "2/3 × 9/10 = 18/30 = 3/5",
      "commonMistake": "Flipping the first fraction instead of the divisor.",
      "applicationPrompt": "Find 2/3 × 9/10.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "fr-mixed-f",
      "topicId": "fractions",
      "conceptId": "fr-mixed",
      "title": "Mixed numbers",
      "prompt": "How do you turn a mixed number into an improper fraction?",
      "formula": "a b/c = (a × c + b) ÷ c",
      "variables": [],
      "explanation": "Each whole is c parts, so a wholes make a × c parts; add the b extra parts.",
      "example": "3 2/5 = (3 × 5 + 2)/5 = 17/5",
      "commonMistake": "Multiplying whole parts and fractional parts separately.",
      "applicationPrompt": "Write 3 2/5 as an improper fraction.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "fr-remaining-f",
      "topicId": "fractions",
      "conceptId": "fr-word",
      "title": "Fraction of the remainder",
      "prompt": "A person spends 1/3 of a sum, then 1/4 of what is left. How much remains?",
      "formula": "Remaining = Total × (1 − 1/3) × (1 − 1/4)",
      "variables": [],
      "explanation": "The second fraction applies to the balance after the first spend, so multiply the surviving fractions.",
      "example": "1 × 2/3 × 3/4 = 1/2 remains",
      "commonMistake": "Adding 1/3 + 1/4 as fractions of the original amount.",
      "applicationPrompt": "A man spends 1/3 of his salary, then 1/4 of the rest. What fraction of his salary is left?",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "fr-sc-same-gap",
      "topicId": "fractions",
      "conceptId": "fr-compare",
      "kind": "shortcut",
      "title": "Same gap between top and bottom",
      "prompt": "Several proper fractions each have a numerator the same amount below the denominator. Which is largest?",
      "formula": "Same gap: the fraction with the larger numbers is larger",
      "variables": [],
      "explanation": "Each fraction is 1 minus (gap ÷ denominator); a bigger denominator makes the missing piece smaller.",
      "example": "7/9 and 11/13 both have a gap of 2: 11/13 is larger.",
      "commonMistake": "Assuming the fraction with smaller numbers is larger.",
      "applicationPrompt": "Arrange 5/8, 9/12 and 14/17 in ascending order.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    },
    {
      "id": "fr-sc-telescoping",
      "topicId": "fractions",
      "conceptId": "fr-operations",
      "kind": "shortcut",
      "title": "Splitting 1/(n(n + 1))",
      "prompt": "How do you add fractions such as 1/2 + 1/6 + 1/12 + 1/20 quickly?",
      "formula": "1/(n(n + 1)) = 1/n − 1/(n + 1)\nSum from 1/(1 × 2) to 1/(n(n + 1)) = n/(n + 1)",
      "variables": [],
      "explanation": "Written as differences, every middle term cancels with its neighbour.",
      "example": "1/2 + 1/6 + 1/12 + 1/20 = 1 − 1/5 = 4/5.",
      "commonMistake": "Finding a common denominator for all the terms.",
      "applicationPrompt": "Find 1/(1 × 2) + 1/(2 × 3) + … + 1/(9 × 10).",
      "tags": [
        "shortcut"
      ],
      "difficulty": "complex"
    }
  ],

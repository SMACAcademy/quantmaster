  "formulas": [
    {
      "id": "ap-nth",
      "topicId": "arithmetic-progression",
      "conceptId": "ap-nth-term",
      "title": "nth term of an AP",
      "prompt": "What is the formula for the nth term of an arithmetic progression?",
      "formula": "aₙ = a + (n − 1)d",
      "variables": [
        {
          "symbol": "a",
          "meaning": "first term"
        },
        {
          "symbol": "d",
          "meaning": "common difference"
        },
        {
          "symbol": "n",
          "meaning": "position of the term"
        }
      ],
      "explanation": "You take (n − 1) steps to get from the first term to the nth, not n steps.",
      "example": "5, 8, 11, …\na = 5, d = 3\n10th term = 5 + 9 × 3 = 32",
      "commonMistake": "Using n instead of (n − 1), which overshoots by one step.",
      "applicationPrompt": "For the sequence 5, 8, 11, …, which formula gives the 10th term?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ap-sum-formula",
      "topicId": "arithmetic-progression",
      "conceptId": "ap-sum",
      "title": "Sum of n terms",
      "prompt": "What are the two forms of the sum of an AP?",
      "formula": "Sₙ = n/2 × [2a + (n − 1)d]\nSₙ = n/2 × (first + last)",
      "variables": [],
      "explanation": "Use the second form whenever you know the last term — it is much faster.",
      "example": "2, 4, 6, …, 20 (10 terms)\nS = 10/2 × (2 + 20) = 110",
      "commonMistake": "Using the first form when the last term is already known, which invites arithmetic slips.",
      "applicationPrompt": "You know the first and last terms and the count. Which sum formula is quickest?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ap-count-formula",
      "topicId": "arithmetic-progression",
      "conceptId": "ap-count",
      "title": "Number of terms",
      "prompt": "How many terms are there from a to l with common difference d?",
      "formula": "n = (l − a) ÷ d + 1",
      "variables": [
        {
          "symbol": "l",
          "meaning": "last term"
        }
      ],
      "explanation": "Count the gaps, then add one for the starting term — the classic fence-post correction.",
      "example": "7, 11, 15, …, 99\nn = (99 − 7) ÷ 4 + 1 = 24",
      "commonMistake": "Forgetting the +1 and reporting one term too few.",
      "applicationPrompt": "How many terms are there in 7, 11, 15, …, 99?",
      "tags": [
        "core",
        "trap"
      ],
      "difficulty": "medium"
    },
    {
      "id": "ap-average",
      "topicId": "arithmetic-progression",
      "conceptId": "ap-sum",
      "kind": "shortcut",
      "title": "Average of an AP",
      "prompt": "What is the average of the terms of an AP?",
      "formula": "Average = (First + Last) ÷ 2",
      "variables": [],
      "explanation": "Evenly spaced terms are symmetric about their middle, so the average is the midpoint — and the sum is that average times the count.",
      "example": "7, 11, …, 99\nAverage = (7 + 99) ÷ 2 = 53",
      "commonMistake": "Applying this to sequences that are not evenly spaced.",
      "applicationPrompt": "You need the average of a long evenly spaced list. What is the shortcut?",
      "tags": [
        "shortcut",
        "average-link"
      ],
      "difficulty": "easy"
    }
  ],
  "levels": [
    {
      "id": "arithmetic-progression-level-0",
      "topicId": "arithmetic-progression",
      "order": 0,
      "title": "Constant Steps",
      "description": "What makes a sequence an AP, and the two formulas that follow from it.",
      "type": "concept",
      "difficulty": "easy",
      "estimatedMinutes": 5,
      "prerequisiteLevelIds": [],
      "conceptIds": [
        "ap-recognise",
        "ap-nth-term"
      ],
      "xpReward": 20,
      "lesson": {
        "blocks": [
          {
            "type": "text",
            "title": "One rule defines an AP",
            "body": "In an arithmetic progression, each term differs from the previous one by the same amount, called the common difference d.\n\n3, 7, 11, 15 … has d = 4. 20, 17, 14 … has d = −3. A negative d simply means the sequence falls."
          },
          {
            "type": "formula",
            "title": "The two formulas",
            "body": "aₙ = a + (n − 1)d\nSₙ = n/2 × (first + last)",
            "caption": "Note (n − 1), not n: reaching the 10th term takes 9 steps."
          },
          {
            "type": "example",
            "title": "Both in action",
            "body": "Sequence 5, 8, 11, …\na = 5, d = 3\n10th term = 5 + 9 × 3 = 32\nSum of the first 10 = 10/2 × (5 + 32) = 185"
          },
          {
            "type": "callout",
            "tone": "info",
            "body": "The sum formula is just 'average × count' in disguise: the average of an evenly spaced list is (first + last)/2."
          },
          {
            "type": "check",
            "questionId": "arithmetic-progression-q-002"
          },
          {
            "type": "text",
            "title": "Counting terms needs care",
            "body": "From 7 to 99 in steps of 4 there are (99 − 7)/4 = 23 steps — but 24 terms. Count the gaps, then add one for the first term."
          },
          {
            "type": "simulation",
            "simulationId": "ap-pairing"
          },
          {
            "type": "check",
            "questionId": "arithmetic-progression-q-020"
          }
        ]
      }
    },

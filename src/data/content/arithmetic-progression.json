    {
      "id": "arithmetic-progression-q-001",
      "topicId": "arithmetic-progression",
      "conceptId": "ap-recognise",
      "levelId": "arithmetic-progression-level-2",
      "difficulty": "easy",
      "learningStage": "foundation",
      "type": "single_choice",
      "question": "What is the common difference of the sequence 3, 7, 11, 15, …?",
      "options": [
        {
          "id": "a",
          "text": "3"
        },
        {
          "id": "b",
          "text": "4"
        },
        {
          "id": "c",
          "text": "7"
        },
        {
          "id": "d",
          "text": "11"
        }
      ],
      "correctAnswer": [
        "b"
      ],
      "explanation": "Each term is 4 more than the previous one: 7 − 3 = 4, 11 − 7 = 4.",
      "solutionSteps": [
        "Subtract any term from the one after it.",
        "7 − 3 = 4.",
        "Common difference d = 4."
      ],
      "formulaIds": [
        "ap-nth"
      ],
      "method": "Subtract consecutive terms.",
      "hints": [
        {
          "level": 1,
          "text": "Take any two neighbouring terms and subtract."
        }
      ],
      "commonMistakes": [
        "Reporting the first term instead of the difference."
      ],
      "tags": [
        "basic"
      ],
      "estimatedSeconds": 20,
      "source": "original",
      "version": 1,
      "active": true
    },

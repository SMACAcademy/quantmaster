  "formulas": [
    {
      "id": "trig-ratios-f",
      "topicId": "trigonometry",
      "conceptId": "trig-ratios",
      "title": "The three ratios",
      "prompt": "In a right triangle, how are sin θ, cos θ and tan θ defined?",
      "formula": "sin θ = Opposite ÷ Hypotenuse\ncos θ = Adjacent ÷ Hypotenuse\ntan θ = Opposite ÷ Adjacent = sin θ ÷ cos θ",
      "variables": [
        {
          "symbol": "Opposite",
          "meaning": "the side facing θ"
        },
        {
          "symbol": "Adjacent",
          "meaning": "the side next to θ (not the hypotenuse)"
        },
        {
          "symbol": "Hypotenuse",
          "meaning": "the side facing the right angle"
        }
      ],
      "explanation": "Each ratio compares two sides as seen from the angle θ. They depend only on the angle, not on the size of the triangle.",
      "example": "Sides 3, 4, 5 with θ opposite 3: sin θ = 3/5, cos θ = 4/5, tan θ = 3/4.",
      "commonMistake": "Measuring \"opposite\" and \"adjacent\" from the wrong angle.",
      "applicationPrompt": "A ladder makes angle θ with the ground. Which ratio links its length to the height it reaches?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "trig-reciprocal-f",
      "topicId": "trigonometry",
      "conceptId": "trig-complementary",
      "title": "The reciprocal ratios",
      "prompt": "What are cosec θ, sec θ and cot θ?",
      "formula": "cosec θ = 1 ÷ sin θ\nsec θ = 1 ÷ cos θ\ncot θ = 1 ÷ tan θ",
      "variables": [],
      "explanation": "Each is the first three ratios turned upside down.",
      "example": "sin θ = 3/5 gives cosec θ = 5/3.",
      "commonMistake": "Pairing sec with sin and cosec with cos: the \"co\" ratios pair with each other.",
      "applicationPrompt": "If cos θ = 0.8, what is sec θ?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "trig-standard-f",
      "topicId": "trigonometry",
      "conceptId": "trig-standard",
      "title": "Values at the standard angles",
      "prompt": "What are sin θ and cos θ at 0°, 30°, 45°, 60° and 90°?",
      "formula": "θ:     0°   30°   45°    60°    90°\nsin θ: 0    1/2   1/√2   √3/2   1\ncos θ: 1    √3/2  1/√2   1/2    0\ntan θ: 0    1/√3  1      √3     not defined",
      "variables": [],
      "explanation": "The sines are √0/2, √1/2, √2/2, √3/2, √4/2. The cosines are the same list backwards. tan θ = sin θ ÷ cos θ.",
      "example": "sin 30° + cos 60° = 1/2 + 1/2 = 1.",
      "commonMistake": "Swapping the sine and cosine of 30° and 60°.",
      "applicationPrompt": "Find 2 sin 30° × tan 60° × cos 30°.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "trig-complementary-f",
      "topicId": "trigonometry",
      "conceptId": "trig-complementary",
      "title": "Complementary angles",
      "prompt": "How does a ratio of (90° − θ) relate to a ratio of θ?",
      "formula": "sin(90° − θ) = cos θ   cos(90° − θ) = sin θ\ntan(90° − θ) = cot θ   sec(90° − θ) = cosec θ",
      "variables": [],
      "explanation": "The two acute angles of a right triangle add to 90°, and the side opposite one is adjacent to the other.",
      "example": "tan 20° × tan 70° = tan 20° × cot 20° = 1.",
      "commonMistake": "Using it when the angles add to 180°, not 90°.",
      "applicationPrompt": "Simplify sin² 25° + sin² 65°.",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "trig-pythag-f",
      "topicId": "trigonometry",
      "conceptId": "trig-identities",
      "title": "The Pythagorean identities",
      "prompt": "Which identities hold for every angle θ?",
      "formula": "sin²θ + cos²θ = 1\n1 + tan²θ = sec²θ\n1 + cot²θ = cosec²θ",
      "variables": [],
      "explanation": "The first is Pythagoras in a triangle with hypotenuse 1; divide it by cos²θ or sin²θ to get the other two.",
      "example": "sec²θ − tan²θ = 1 for every θ, so 7(sec²θ − tan²θ) = 7.",
      "commonMistake": "Writing sin θ + cos θ = 1: it is the squares that add to 1.",
      "applicationPrompt": "If sin θ = 0.6, find cos θ without knowing θ.",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "trig-one-ratio-f",
      "topicId": "trigonometry",
      "conceptId": "trig-one-ratio",
      "title": "From one ratio to the rest",
      "prompt": "You are told tan θ = 3/4. How do you find sin θ and cos θ?",
      "formula": "Draw a right triangle with those two sides,\nfind the third side by Pythagoras,\nthen read off any ratio",
      "variables": [],
      "explanation": "A ratio fixes the shape of the triangle; Pythagoras completes it.",
      "example": "tan θ = 3/4: sides 3 and 4, hypotenuse 5, so sin θ = 3/5 and cos θ = 4/5.",
      "commonMistake": "Taking the hypotenuse as one of the two given sides when the ratio is a tangent.",
      "applicationPrompt": "If sec θ = 13/12, find tan θ.",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "trig-sc-max",
      "topicId": "trigonometry",
      "conceptId": "trig-identities",
      "kind": "shortcut",
      "title": "Largest value of a sin θ + b cos θ",
      "prompt": "What are the largest and smallest values of a sin θ + b cos θ?",
      "formula": "Largest: √(a² + b²)\nSmallest: −√(a² + b²)",
      "variables": [],
      "explanation": "a sin θ + b cos θ can be rewritten as √(a² + b²) × sin(θ + α), and a sine never goes beyond ±1.",
      "example": "3 sin θ + 4 cos θ is at most √(9 + 16) = 5.",
      "commonMistake": "Answering a + b = 7, which the expression never reaches.",
      "applicationPrompt": "Find the maximum of 5 sin θ + 12 cos θ.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "complex"
    },
    {
      "id": "trig-sc-sec-tan",
      "topicId": "trigonometry",
      "conceptId": "trig-identities",
      "kind": "shortcut",
      "title": "sec θ + tan θ given",
      "prompt": "sec θ + tan θ = k. What is sec θ − tan θ?",
      "formula": "sec θ − tan θ = 1 ÷ k\n(because sec²θ − tan²θ = 1)",
      "variables": [],
      "explanation": "Factorise sec²θ − tan²θ = 1 as (sec θ + tan θ)(sec θ − tan θ) = 1.",
      "example": "sec θ + tan θ = 2 gives sec θ − tan θ = 1/2, so sec θ = 5/4 and tan θ = 3/4.",
      "commonMistake": "Trying to find θ first.",
      "applicationPrompt": "If sec θ + tan θ = 3, find tan θ.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "complex"
    }

      "lesson": {
        "blocks": [
          {
            "type": "text",
            "title": "Name the sides from the angle",
            "body": "In a right triangle, pick one of the acute angles and call it θ. The side facing θ is the opposite side, the side next to θ (other than the longest) is the adjacent side, and the side facing the right angle is the hypotenuse."
          },
          {
            "type": "formula",
            "title": "SOH CAH TOA",
            "body": "sin θ = Opposite ÷ Hypotenuse\ncos θ = Adjacent ÷ Hypotenuse\ntan θ = Opposite ÷ Adjacent",
            "caption": "The ratios depend only on the angle, not on how big the triangle is."
          },
          {
            "type": "example",
            "title": "A 3-4-5 triangle",
            "body": "With θ opposite the side of 3: sin θ = 3/5, cos θ = 4/5, tan θ = 3/4."
          },
          {
            "type": "check",
            "questionId": "trigonometry-q-001"
          },
          {
            "type": "simulation",
            "simulationId": "trig-triangle"
          },
          {
            "type": "text",
            "title": "The standard angles",
            "body": "For 0°, 30°, 45°, 60° and 90°, the sines are √0/2, √1/2, √2/2, √3/2 and √4/2: that is 0, 1/2, 1/√2, √3/2 and 1. The cosines are the same list read backwards, and tan θ = sin θ ÷ cos θ."
          },
          {
            "type": "check",
            "questionId": "trigonometry-q-002"
          },
          {
            "type": "callout",
            "tone": "tip",
            "body": "sin²θ + cos²θ = 1 for every angle: it is Pythagoras in a triangle whose hypotenuse is 1. Questions that look like hard calculations often collapse to this."
          },
          {
            "type": "check",
            "questionId": "trigonometry-q-004"
          }
        ]
      },
      "xpReward": 20

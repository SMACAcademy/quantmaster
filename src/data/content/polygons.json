  "formulas": [
    {
      "id": "poly-interiorsum-f",
      "topicId": "polygons",
      "conceptId": "poly-interiorsum",
      "title": "Interior angle sum",
      "prompt": "What do the interior angles of an n-sided polygon add up to?",
      "formula": "Sum of interior angles = (n − 2) × 180°",
      "variables": [],
      "explanation": "A polygon with n sides can be split into (n − 2) triangles from one vertex, and each triangle contributes 180°.",
      "example": "A hexagon (n = 6): sum = (6 − 2) × 180 = 720°",
      "commonMistake": "Forgetting to subtract 2 from n before multiplying by 180°.",
      "applicationPrompt": "Find the sum of the interior angles of a hexagon.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "poly-regular-f",
      "topicId": "polygons",
      "conceptId": "poly-regular",
      "title": "Interior angle of a regular polygon",
      "prompt": "How do you find one interior angle of a regular polygon?",
      "formula": "Each interior angle = (n − 2) × 180° ÷ n",
      "variables": [],
      "explanation": "Divide the total interior angle sum equally among all n vertices, since a regular polygon's angles are all equal.",
      "example": "A regular hexagon: (6 − 2) × 180 ÷ 6 = 720 ÷ 6 = 120°",
      "commonMistake": "Using the total angle sum as the answer instead of dividing by n.",
      "applicationPrompt": "Find one interior angle of a regular hexagon.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "poly-diagonals-f",
      "topicId": "polygons",
      "conceptId": "poly-diagonals",
      "title": "Number of diagonals",
      "prompt": "How many diagonals does an n-sided polygon have?",
      "formula": "Number of diagonals = n(n − 3) ÷ 2",
      "variables": [],
      "explanation": "From each vertex you can draw a diagonal to every vertex except itself and its two neighbours, giving (n − 3) diagonals per vertex; dividing by 2 avoids double-counting.",
      "example": "A pentagon (n = 5): 5(5 − 3) ÷ 2 = 10 ÷ 2 = 5",
      "commonMistake": "Forgetting to divide by 2, which double-counts every diagonal.",
      "applicationPrompt": "Find the number of diagonals in a pentagon.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "poly-extangle-f",
      "topicId": "polygons",
      "conceptId": "poly-extangle",
      "title": "Exterior angle of a regular polygon",
      "prompt": "How do you find one exterior angle of a regular polygon?",
      "formula": "Each exterior angle = 360° ÷ n",
      "variables": [],
      "explanation": "The exterior angles always sum to 360° in total, and a regular polygon splits that total equally among its n vertices.",
      "example": "A regular pentagon: 360 ÷ 5 = 72°",
      "commonMistake": "Using the interior angle formula by mistake when the question asks for the exterior angle.",
      "applicationPrompt": "Find one exterior angle of a regular pentagon.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },

  "formulas": [
    {
      "id": "si-laws-f",
      "topicId": "surds-indices",
      "conceptId": "si-laws",
      "title": "Laws of indices",
      "prompt": "How do you combine powers of the same base?",
      "formula": "aᵐ × aⁿ = aᵐ⁺ⁿ\naᵐ ÷ aⁿ = aᵐ⁻ⁿ\n(aᵐ)ⁿ = aᵐⁿ\n(ab)ⁿ = aⁿbⁿ",
      "variables": [],
      "explanation": "A power is repeated multiplication, so multiplying powers of one base just counts the total number of factors.",
      "example": "2³ × 2⁴ = 2⁷ = 128\n(3²)³ = 3⁶ = 729",
      "commonMistake": "Multiplying the exponents when multiplying the powers (2³ × 2⁴ ≠ 2¹²).",
      "applicationPrompt": "Find 2³ × 2⁴.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "si-fractional-f",
      "topicId": "surds-indices",
      "conceptId": "si-fractional",
      "title": "Special exponents",
      "prompt": "What do a zero, negative or fractional exponent mean?",
      "formula": "a⁰ = 1\na⁻ⁿ = 1/aⁿ\na^(1/n) = ⁿ√a\na^(m/n) = (ⁿ√a)ᵐ",
      "variables": [],
      "explanation": "These definitions keep the laws of indices working: a³ ÷ a³ must be 1, so a⁰ = 1.",
      "example": "2⁻³ = 1/8\n16^(3/4) = (⁴√16)³ = 2³ = 8",
      "commonMistake": "Treating a negative exponent as a negative number.",
      "applicationPrompt": "Find 16^(3/4).",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "si-surd-f",
      "topicId": "surds-indices",
      "conceptId": "si-surds",
      "title": "Surd rules",
      "prompt": "How do you simplify and combine surds?",
      "formula": "√(ab) = √a × √b\n√a × √a = a\nk√a + m√a = (k + m)√a",
      "variables": [],
      "explanation": "Take out perfect-square factors. Only surds with the same radicand can be added.",
      "example": "√50 = √25 × √2 = 5√2\n3√2 + 5√2 − √2 = 7√2",
      "commonMistake": "Adding surds with different radicands (√2 + √3 ≠ √5).",
      "applicationPrompt": "Simplify √50.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "si-equation-f",
      "topicId": "surds-indices",
      "conceptId": "si-equations",
      "title": "Equal bases",
      "prompt": "How do you solve an equation with the unknown in an exponent?",
      "formula": "aˣ = aʸ  ⇒  x = y  (a > 0, a ≠ 1)",
      "variables": [],
      "explanation": "Write both sides as powers of the same base, then the exponents must match.",
      "example": "9^(x+1) = 27^(x−1)\n3^(2x+2) = 3^(3x−3) → x = 5",
      "commonMistake": "Equating the bases or the exponents before making the bases equal.",
      "applicationPrompt": "Solve 9^(x+1) = 27^(x−1).",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "si-rationalise-f",
      "topicId": "surds-indices",
      "conceptId": "si-rationalise",
      "title": "Rationalising",
      "prompt": "How do you remove a surd from a denominator?",
      "formula": "1/√a = √a/a\n1/(√a − √b) = (√a + √b)/(a − b)\n1/(√a + √b) = (√a − √b)/(a − b)",
      "variables": [],
      "explanation": "Multiplying by the conjugate turns the denominator into a difference of squares, which is rational.",
      "example": "1/(√5 − √2) = (√5 + √2)/(5 − 2) = (√5 + √2)/3",
      "commonMistake": "Forgetting to divide by a − b.",
      "applicationPrompt": "Rationalise 1/(√5 − √2).",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "si-sc-same-base",
      "topicId": "surds-indices",
      "conceptId": "si-equations",
      "kind": "shortcut",
      "title": "Make the bases match",
      "prompt": "An equation has powers of 4, 8 and 16. What do you do first?",
      "formula": "Rewrite every number as a power of the same prime, then equate the powers",
      "variables": [],
      "explanation": "Once the bases are equal, the exponents must be equal.",
      "example": "4ˣ = 8: 2^(2x) = 2³, so x = 3/2.",
      "commonMistake": "Equating exponents while the bases are still different.",
      "applicationPrompt": "Solve 9^(x + 1) = 27^x.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    },
    {
      "id": "si-sc-compare-roots",
      "topicId": "surds-indices",
      "conceptId": "si-surds",
      "kind": "shortcut",
      "title": "Comparing roots of different orders",
      "prompt": "Which is larger, ∛4 or √3?",
      "formula": "Raise both to the LCM of the root orders, then compare whole numbers",
      "variables": [],
      "explanation": "Raising positive numbers to the same power keeps their order and removes the roots.",
      "example": "∛4 and √3: raise to the 6th power: 4² = 16 and 3³ = 27, so √3 is larger.",
      "commonMistake": "Comparing 4 and 3 directly and ignoring the different roots.",
      "applicationPrompt": "Arrange ∜5, √2 and ∛3 in order.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    },
    {
      "id": "si-sc-nested",
      "topicId": "surds-indices",
      "conceptId": "si-rationalise",
      "kind": "shortcut",
      "title": "Square root of a + 2√b",
      "prompt": "How do you simplify √(7 + 2√10)?",
      "formula": "√(a + 2√b) = √x + √y\nwhere x + y = a and xy = b",
      "variables": [],
      "explanation": "(√x + √y)² = x + y + 2√(xy), so match the two parts.",
      "example": "√(7 + 2√10): numbers adding to 7 and multiplying to 10 are 5 and 2, so it is √5 + √2.",
      "commonMistake": "Forgetting to make the middle term 2√b first, for example 8 + √60 = 8 + 2√15.",
      "applicationPrompt": "Simplify √(8 + 2√15).",
      "tags": [
        "shortcut"
      ],
      "difficulty": "complex"
    }
  ],

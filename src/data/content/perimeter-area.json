{
  "topicId": "perimeter-area",
  "concepts": [
    {
      "id": "pa-rectangle",
      "topicId": "perimeter-area",
      "name": "Rectangles and squares",
      "description": "Perimeter = 2 × (length + breadth); Area = length × breadth. A square is the special case where length equals breadth.",
      "sortOrder": 1
    },
    {
      "id": "pa-triangle",
      "topicId": "perimeter-area",
      "name": "Triangles",
      "description": "Perimeter is the sum of the three sides; Area = ½ × base × height, where the height is measured perpendicular to the chosen base.",
      "sortOrder": 2
    },
    {
      "id": "pa-parallelogram-trapezium",
      "topicId": "perimeter-area",
      "name": "Parallelograms and trapeziums",
      "description": "Area of a parallelogram = base × height; area of a trapezium = ½ × (sum of the parallel sides) × height.",
      "sortOrder": 3
    },
    {
      "id": "pa-circle",
      "topicId": "perimeter-area",
      "name": "Circles",
      "description": "Circumference = 2πr; Area = πr², where r is the radius.",
      "sortOrder": 4
    },
    {
      "id": "pa-rhombus",
      "topicId": "perimeter-area",
      "name": "Rhombuses",
      "description": "Area of a rhombus = ½ × product of its two diagonals.",
      "sortOrder": 5
    }
  ],
  "formulas": [
    {
      "id": "pa-rectangle-f",
      "topicId": "perimeter-area",
      "conceptId": "pa-rectangle",
      "title": "Perimeter and area of a rectangle",
      "prompt": "How do you find the perimeter and area of a rectangle?",
      "formula": "Perimeter = 2(l + b); Area = l × b",
      "variables": [],
      "explanation": "l is the length and b is the breadth. For a square, l = b, so perimeter = 4s and area = s².",
      "example": "Length 8 cm, breadth 5 cm: perimeter = 2(8 + 5) = 26 cm; area = 8 × 5 = 40 cm²",
      "commonMistake": "Adding length and breadth once instead of doubling the sum for the perimeter.",
      "applicationPrompt": "A rectangle has length 8 cm and breadth 5 cm. Find its perimeter and area.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "pa-triangle-f",
      "topicId": "perimeter-area",
      "conceptId": "pa-triangle",
      "title": "Perimeter and area of a triangle",
      "prompt": "How do you find the perimeter and area of a triangle?",
      "formula": "Perimeter = a + b + c; Area = ½ × base × height",
      "variables": [],
      "explanation": "The height must be the perpendicular distance from the chosen base to the opposite vertex, not a slanted side.",
      "example": "Base 10 cm, height 6 cm: area = ½ × 10 × 6 = 30 cm²",
      "commonMistake": "Using a slanted side length as the height instead of the perpendicular distance.",
      "applicationPrompt": "A triangle has base 10 cm and height 6 cm. Find its area.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "pa-trapezium-f",
      "topicId": "perimeter-area",
      "conceptId": "pa-parallelogram-trapezium",
      "title": "Area of a parallelogram and a trapezium",
      "prompt": "How do you find the area of a parallelogram or a trapezium?",
      "formula": "Parallelogram: Area = base × height; Trapezium: Area = ½ × (a + b) × height",
      "variables": [],
      "explanation": "For the trapezium formula, a and b are the lengths of the two parallel sides, and height is the perpendicular distance between them.",
      "example": "Trapezium with parallel sides 10 cm and 14 cm, height 6 cm: area = ½ × (10 + 14) × 6 = 72 cm²",
      "commonMistake": "Forgetting to add both parallel sides before halving in the trapezium formula.",
      "applicationPrompt": "A trapezium has parallel sides 10 cm and 14 cm, and height 6 cm. Find its area.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "pa-circle-f",
      "topicId": "perimeter-area",
      "conceptId": "pa-circle",
      "title": "Circumference and area of a circle",
      "prompt": "How do you find the circumference and area of a circle?",
      "formula": "Circumference = 2πr; Area = πr²",
      "variables": [],
      "explanation": "r is the radius. Use π ≈ 22/7 when the radius is a multiple of 7, otherwise π ≈ 3.14.",
      "example": "Radius 7 cm: circumference = 2 × 22/7 × 7 = 44 cm; area = 22/7 × 7 × 7 = 154 cm²",
      "commonMistake": "Using the diameter in place of the radius without adjusting the formula.",
      "applicationPrompt": "A circle has radius 7 cm. Find its circumference and area.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "pa-rhombus-f",
      "topicId": "perimeter-area",
      "conceptId": "pa-rhombus",
      "title": "Area of a rhombus",
      "prompt": "How do you find the area of a rhombus from its diagonals?",
      "formula": "Area = ½ × d₁ × d₂",
      "variables": [],
      "explanation": "d₁ and d₂ are the lengths of the two diagonals, which always cross at right angles in a rhombus.",
      "example": "Diagonals 12 cm and 16 cm: area = ½ × 12 × 16 = 96 cm²",
      "commonMistake": "Using one diagonal alone, or forgetting the ½, and computing d₁ × d₂ directly.",
      "applicationPrompt": "A rhombus has diagonals 12 cm and 16 cm. Find its area.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "pa-sc-percent-area",
      "topicId": "perimeter-area",
      "conceptId": "pa-rectangle",
      "kind": "shortcut",
      "title": "Both sides change by x%",
      "prompt": "Each side of a rectangle (or square) grows by x%. By how much does the area grow?",
      "formula": "Area change = 2x + x²/100 %\n(the successive change rule with a = b = x)",
      "variables": [],
      "explanation": "Area is length × width, so the two percentage changes combine.",
      "example": "Each side up 10%: area up 21%. Each side down 10%: area down 19%.",
      "commonMistake": "Saying the area also rises by 10%, or by 20%.",
      "applicationPrompt": "The radius of a circle rises by 20%. By what percentage does its area rise?",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    },
    {
      "id": "pa-sc-heron",
      "topicId": "perimeter-area",
      "conceptId": "pa-triangle",
      "kind": "shortcut",
      "title": "Heron's formula",
      "prompt": "How do you find a triangle's area from its three sides alone?",
      "formula": "s = (a + b + c) ÷ 2\nArea = √(s(s − a)(s − b)(s − c))",
      "variables": [],
      "explanation": "It needs no height. The 13-14-15 triangle (area 84) is a favourite.",
      "example": "13, 14, 15: s = 21, area = √(21 × 8 × 7 × 6) = √7,056 = 84.",
      "commonMistake": "Using the perimeter instead of half of it.",
      "applicationPrompt": "Find the area of a triangle with sides 5, 5 and 6.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    },
    {
      "id": "pa-sc-max-area",
      "topicId": "perimeter-area",
      "conceptId": "pa-rectangle",
      "kind": "shortcut",
      "title": "Fixed perimeter, largest area",
      "prompt": "With a fixed length of fencing, which rectangle encloses the most?",
      "formula": "A square, with side = perimeter ÷ 4\n(a circle beats every shape)",
      "variables": [],
      "explanation": "For a fixed sum of two sides, their product is largest when they are equal.",
      "example": "Perimeter 40: a 10 × 10 square gives 100, a 12 × 8 rectangle only 96.",
      "commonMistake": "Assuming every rectangle with the same perimeter has the same area.",
      "applicationPrompt": "What is the largest rectangular area 60 m of fencing can enclose?",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    }
  ],

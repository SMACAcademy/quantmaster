{
  "topicId": "approximation",
  "concepts": [
    {
      "id": "ap-round",
      "topicId": "approximation",
      "name": "Rounding",
      "description": "Look at the digit just after the place you keep: 5 or more rounds up, less than 5 rounds down.",
      "sortOrder": 1
    },
    {
      "id": "ap-friendly",
      "topicId": "approximation",
      "name": "Compatible round numbers",
      "description": "Replace awkward numbers with nearby round ones that multiply or divide easily.",
      "sortOrder": 2
    },
    {
      "id": "ap-percent",
      "topicId": "approximation",
      "name": "Percent–fraction equivalents",
      "description": "Common percents are simple fractions: 12.5% = 1/8, 33⅓% = 1/3, 16⅔% = 1/6.",
      "sortOrder": 3
    },
    {
      "id": "ap-roots",
      "topicId": "approximation",
      "name": "Estimating roots",
      "description": "Sandwich a root between two neighbouring perfect squares.",
      "sortOrder": 4
    },
    {
      "id": "ap-bias",
      "topicId": "approximation",
      "name": "Direction and size of error",
      "description": "Rounding all the numbers the same way biases the answer; opposite rounding partly cancels.",
      "sortOrder": 5
    },
    {
      "id": "ap-adv-compare",
      "topicId": "approximation",
      "name": "Comparing without full calculation",
      "description": "You only need to know which quantity is larger. Simplify both into the same form (same base, same factor, a benchmark) and compare what is left.",
      "sortOrder": 6
    },
    {
      "id": "ap-adv-unknowns",
      "topicId": "approximation",
      "name": "When the answer cannot be determined",
      "description": "If a quantity depends on an unknown, test values the condition allows: 0, 1, negatives, fractions and large numbers. If different values give different answers, the relationship cannot be determined.",
      "sortOrder": 7
    }
  ],
  "formulas": [
    {
      "id": "ap-round-f",
      "topicId": "approximation",
      "conceptId": "ap-round",
      "title": "Rounding rule",
      "prompt": "How do you round a number to a given place?",
      "formula": "Look one place to the right.\n≥ 5 → round up;  < 5 → round down",
      "variables": [],
      "explanation": "Half-way and above rounds up. Everything to the right of the kept place then becomes zero (or is dropped after the decimal point).",
      "example": "4,567 → nearest 100: 4,600\n3.4567 → 2 decimals: 3.46",
      "commonMistake": "Cutting the digits off instead of rounding.",
      "applicationPrompt": "Round 4,567 to the nearest hundred.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ap-friendly-f",
      "topicId": "approximation",
      "conceptId": "ap-friendly",
      "title": "Compatible numbers",
      "prompt": "How do you estimate a product or quotient of awkward numbers?",
      "formula": "Replace each number by a nearby round number, then compute",
      "variables": [],
      "explanation": "Choose numbers that make the operation easy: 25 × 4, 50 × 20, 5,000 ÷ 25.",
      "example": "49.8 × 20.1 ≈ 50 × 20 = 1,000",
      "commonMistake": "Getting the magnitude wrong by a factor of ten.",
      "applicationPrompt": "Estimate 49.8 × 20.1.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ap-percent-f",
      "topicId": "approximation",
      "conceptId": "ap-percent",
      "kind": "shortcut",
      "title": "Percent as fractions",
      "prompt": "Which percents are worth knowing as fractions?",
      "formula": "50% = 1/2, 25% = 1/4, 12.5% = 1/8, 6.25% = 1/16\n33⅓% = 1/3, 16⅔% = 1/6, 37.5% = 3/8, 20% = 1/5",
      "variables": [],
      "explanation": "Turning a percent into a fraction turns a multiplication into a division you can do mentally.",
      "example": "12.5% of 640 = 640 ÷ 8 = 80",
      "commonMistake": "Mixing 12.5% with 1/12.",
      "applicationPrompt": "Find 12.5% of 640.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ap-roots-f",
      "topicId": "approximation",
      "conceptId": "ap-roots",
      "kind": "shortcut",
      "title": "Root estimates",
      "prompt": "How do you estimate a square root that is not a perfect square?",
      "formula": "If k² < N < (k + 1)², then k < √N < k + 1\nIn the middle: N ≈ k² + k → √N ≈ k + ½",
      "variables": [],
      "explanation": "The square root lies between the roots of the two neighbouring squares, and closer to whichever is nearer.",
      "example": "√80: 8² = 64 < 80 < 81 = 9² → between 8 and 9, close to 9",
      "commonMistake": "Halving the number.",
      "applicationPrompt": "Between which two whole numbers does √80 lie?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ap-bias-f",
      "topicId": "approximation",
      "conceptId": "ap-bias",
      "title": "Error direction",
      "prompt": "If every number in a product is rounded up, is the estimate too large or too small?",
      "formula": "Round all up → product overestimates\nRound all down → underestimates\nMixed → errors partly cancel",
      "variables": [],
      "explanation": "Because all quantities are positive, a larger factor always gives a larger product. Use this to reject impossible options quickly.",
      "example": "48 × 26: rounding 48 → 50 and 26 → 30 gives 1,500, above the true 1,248",
      "commonMistake": "Assuming rounding errors always cancel.",
      "applicationPrompt": "Both numbers in a product are rounded up. Is the estimate bigger or smaller than the true answer?",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "ap-adv-common-f",
      "topicId": "approximation",
      "conceptId": "ap-adv-compare",
      "title": "Compare like with like",
      "prompt": "How do you compare two quantities quickly?",
      "formula": "Rewrite both in the same form (same base, same power, or a common factor removed), then compare what differs",
      "variables": [],
      "explanation": "Comparing 3²⁰ with 2³⁰ is hard; 9¹⁰ against 8¹⁰ is easy. Removing a shared positive factor never changes which side is larger.",
      "example": "3²⁰ = (3²)¹⁰ = 9¹⁰ and 2³⁰ = (2³)¹⁰ = 8¹⁰, so 3²⁰ is greater",
      "commonMistake": "Comparing only the exponents (30 > 20) and ignoring the bases.",
      "applicationPrompt": "Which is greater: 3²⁰ or 2³⁰?",
      "tags": [
        "advanced"
      ],
      "difficulty": "complex"
    },
    {
      "id": "ap-adv-test-f",
      "topicId": "approximation",
      "conceptId": "ap-adv-unknowns",
      "title": "Testing values for an unknown",
      "prompt": "How do you decide whether a comparison involving an unknown can be determined?",
      "formula": "Test the allowed values 0, 1, −1, a fraction between 0 and 1, and a large number; if the answers differ, it cannot be determined",
      "variables": [],
      "explanation": "Squares, reciprocals and powers behave differently for numbers between 0 and 1, and for negatives. Those are the values that change the answer.",
      "example": "x > 0, A = x², B = x: x = 2 gives A > B, but x = ½ gives A < B, so it cannot be determined",
      "commonMistake": "Testing only whole numbers like 2 and 3, and concluding that x² is always greater.",
      "applicationPrompt": "x > 0. Compare x² with x.",
      "tags": [
        "advanced"
      ],
      "difficulty": "complex"
    },
    {
      "id": "ap-sc-compensate",
      "topicId": "approximation",
      "conceptId": "ap-friendly",
      "kind": "shortcut",
      "title": "Round one up, the other down",
      "prompt": "When estimating a product, how do you keep the rounding errors small?",
      "formula": "Round the two factors in opposite directions",
      "variables": [],
      "explanation": "One rounding makes the product too large and the other too small, so most of the error cancels.",
      "example": "48 × 52 ≈ 50 × 50 = 2,500 (exact value 2,496).",
      "commonMistake": "Rounding both up (50 × 55 = 2,750 for 48 × 52 is far off).",
      "applicationPrompt": "Estimate 39 × 62.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ap-sc-divide-friendly",
      "topicId": "approximation",
      "conceptId": "ap-friendly",
      "kind": "shortcut",
      "title": "Dividing by 5, 25 and 125",
      "prompt": "How do you divide by 5, 25 or 125 without long division?",
      "formula": "÷ 5 = × 2 ÷ 10\n÷ 25 = × 4 ÷ 100\n÷ 125 = × 8 ÷ 1,000",
      "variables": [],
      "explanation": "5, 25 and 125 are 10/2, 100/4 and 1,000/8.",
      "example": "1,300 ÷ 25 = 1,300 × 4 ÷ 100 = 52.",
      "commonMistake": "Dividing by 4 instead of multiplying by 4.",
      "applicationPrompt": "Find 3,500 ÷ 125 mentally.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    }
  ],

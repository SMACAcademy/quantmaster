    {
      "id": "approximation-q-001",
      "topicId": "approximation",
      "conceptId": "ap-round",
      "levelId": "approximation-level-2",
      "difficulty": "easy",
      "learningStage": "independent",
      "type": "single_choice",
      "question": "What is 4,567 rounded to the nearest hundred?",
      "options": [
        {
          "id": "a",
          "text": "4,500"
        },
        {
          "id": "b",
          "text": "4,600"
        },
        {
          "id": "c",
          "text": "4,570"
        },
        {
          "id": "d",
          "text": "5,000"
        }
      ],
      "correctAnswer": [
        "b"
      ],
      "explanation": "The tens digit is 6, which is 5 or more, so round the hundreds digit up: 4,600.",
      "solutionSteps": [
        "Keep the hundreds place: 45.",
        "Next digit 6 ≥ 5 → round up.",
        "4,600."
      ],
      "formulaIds": [
        "ap-round-f"
      ],
      "method": "Look at the digit to the right.",
      "hints": [
        {
          "level": 1,
          "text": "Which digit decides the rounding for the hundreds place?"
        }
      ],
      "commonMistakes": [
        "Cutting the digits off (4,500)."
      ],
      "tags": [
        "basic"
      ],
      "estimatedSeconds": 25,
      "source": "original",
      "version": 1,
      "active": true
    },

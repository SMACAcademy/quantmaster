      "levelId": "direct-inverse-proportion-level-2",
      "difficulty": "easy",
      "learningStage": "recognition",
      "type": "formula_recognition",
      "question": "Two quantities are inversely proportional. Which of these stays constant?",
      "options": [
        {
          "id": "a",
          "text": "Their sum"
        },
        {
          "id": "b",
          "text": "Their difference"
        },
        {
          "id": "c",
          "text": "Their product"
        },
        {
          "id": "d",
          "text": "Their ratio"
        }
      ],
      "correctAnswer": [
        "c"
      ],
      "explanation": "If x doubles, y halves, so x × y stays the same. The ratio is what stays constant in direct proportion.",
      "solutionSteps": [
        "y = k ÷ x → x × y = k."
      ],
      "formulaIds": [
        "dp-inverse-f"
      ],
      "method": "Inverse: product. Direct: ratio.",

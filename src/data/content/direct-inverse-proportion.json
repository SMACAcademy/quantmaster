{
  "topicId": "direct-inverse-proportion",
  "concepts": [
    {
      "id": "dp-identify",
      "topicId": "direct-inverse-proportion",
      "name": "Direct or inverse?",
      "description": "Ask what happens to one quantity when the other increases: rises with it (direct) or falls (inverse).",
      "sortOrder": 1
    },
    {
      "id": "dp-direct",
      "topicId": "direct-inverse-proportion",
      "name": "Direct proportion",
      "description": "The ratio of the two quantities stays constant.",
      "sortOrder": 2
    },
    {
      "id": "dp-inverse",
      "topicId": "direct-inverse-proportion",
      "name": "Inverse proportion",
      "description": "The product of the two quantities stays constant.",
      "sortOrder": 3
    },
    {
      "id": "dp-compound",
      "topicId": "direct-inverse-proportion",
      "name": "Several quantities together",
      "description": "Group every quantity that raises the output on one side and every quantity that lowers it on the other.",
      "sortOrder": 4
    }
  ],
  "formulas": [
    {
      "id": "dp-identify-f",
      "topicId": "direct-inverse-proportion",
      "conceptId": "dp-identify",
      "title": "The test",
      "prompt": "How do you tell direct proportion from inverse proportion?",
      "formula": "More → more (or less → less): direct\nMore → less (or less → more): inverse",
      "variables": [],
      "explanation": "Change one quantity in your head and see which way the other must move.",
      "example": "More pens → more cost: direct\nMore workers → fewer days: inverse",
      "commonMistake": "Treating every \"more\" problem as direct.",
      "applicationPrompt": "Are speed and time (for a fixed distance) directly or inversely proportional?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "dp-direct-f",
      "topicId": "direct-inverse-proportion",
      "conceptId": "dp-direct",
      "title": "Direct proportion",
      "prompt": "y is directly proportional to x. How do you relate two situations?",
      "formula": "y₁ ÷ x₁ = y₂ ÷ x₂\n(equivalently y = k·x)",
      "variables": [],
      "explanation": "Doubling x doubles y, so the ratio y ÷ x never changes.",
      "example": "5 pens cost ₹60 → 12 per pen → 8 pens cost ₹96",
      "commonMistake": "Adding the same amount instead of scaling.",
      "applicationPrompt": "5 pens cost ₹60. What do 8 pens cost?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "dp-inverse-f",
      "topicId": "direct-inverse-proportion",
      "conceptId": "dp-inverse",
      "title": "Inverse proportion",
      "prompt": "y is inversely proportional to x. How do you relate two situations?",
      "formula": "x₁ × y₁ = x₂ × y₂\n(equivalently y = k ÷ x)",
      "variables": [],
      "explanation": "Doubling x halves y, so the product x·y never changes.",
      "example": "6 workers × 10 days = 60 worker-days\n12 workers → 60 ÷ 12 = 5 days",
      "commonMistake": "Scaling both in the same direction.",
      "applicationPrompt": "6 workers take 10 days. How long will 12 workers take?",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "dp-compound-f",
      "topicId": "direct-inverse-proportion",
      "conceptId": "dp-compound",
      "title": "Compound proportion",
      "prompt": "A job depends on men, hours per day and days. How do you compare two cases?",
      "formula": "M₁ × H₁ × D₁ ÷ W₁ = M₂ × H₂ × D₂ ÷ W₂",
      "variables": [],
      "explanation": "Quantities that raise the output multiply on top; quantities that lower it sit below. The whole expression stays constant.",
      "example": "12 men, 8 h, 15 days = 1,440 man-hours\n10 men, 9 h → 1,440 ÷ 90 = 16 days",
      "commonMistake": "Ignoring the hours per day.",
      "applicationPrompt": "12 men working 8 hours a day finish a job in 15 days. How many days will 10 men working 9 hours a day take?",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "dp-sc-one-line",
      "topicId": "direct-inverse-proportion",
      "conceptId": "dp-compound",
      "kind": "shortcut",
      "title": "Chain rule in one line",
      "prompt": "How do you solve a \"men, days, work\" question without setting up a proportion table?",
      "formula": "Answer = old value × (one ratio per changed quantity)\nAsk \"more or less?\" to put each ratio the right way up",
      "variables": [],
      "explanation": "Each changed quantity scales the answer up or down independently.",
      "example": "12 men build 60 m in 10 days. Days for 8 men to build 40 m: 10 × (12/8) × (40/60) = 10 days.",
      "commonMistake": "Putting a ratio upside down: fewer men need more days.",
      "applicationPrompt": "15 pumps empty a tank in 8 hours working 6 hours a day. How many days for 10 pumps working 4 hours a day?",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    }
  ],

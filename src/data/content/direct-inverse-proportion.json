  "questions": [
    {
      "id": "direct-inverse-proportion-q-001",
      "topicId": "direct-inverse-proportion",
      "conceptId": "dp-direct",
      "levelId": "direct-inverse-proportion-level-2",
      "difficulty": "easy",
      "learningStage": "independent",
      "type": "single_choice",
      "question": "5 pens cost ₹60. What is the cost of 8 pens at the same price?",
      "options": [
        {
          "id": "a",
          "text": "₹75"
        },
        {
          "id": "b",
          "text": "₹480"
        },
        {
          "id": "c",
          "text": "₹96"
        },
        {
          "id": "d",
          "text": "₹100"
        }
      ],
      "correctAnswer": [
        "c"
      ],
      "explanation": "One pen costs 60 ÷ 5 = ₹12, so 8 pens cost 8 × 12 = ₹96.",
      "solutionSteps": [
        "Unit price = 60 ÷ 5 = 12.",
        "8 × 12 = 96."
      ],
      "formulaIds": [
        "dp-direct-f"
      ],
      "method": "Find the unit value, then scale.",
      "hints": [
        {
          "level": 1,
          "text": "What does one pen cost?"
        }
      ],
      "commonMistakes": [
        "Adding 3 × 5 = 15 to ₹60."

  "formulas": [
    {
      "id": "sp-bodmas-f",
      "topicId": "simplification",
      "conceptId": "sp-bodmas",
      "title": "BODMAS",
      "prompt": "In what order are the operations in an expression carried out?",
      "formula": "Brackets → Of → Division and Multiplication → Addition and Subtraction\n(D and M left to right; A and S left to right)",
      "variables": [],
      "explanation": "Multiplication and division bind more tightly than addition and subtraction. Within a level, work left to right.",
      "example": "8 + 6 × 3 = 8 + 18 = 26\n48 ÷ 6 × 2 = 8 × 2 = 16",
      "commonMistake": "Working strictly left to right, or doing multiplication before division.",
      "applicationPrompt": "Evaluate 48 ÷ 6 × 2.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "sp-identity-f",
      "topicId": "simplification",
      "conceptId": "sp-shortcuts",
      "title": "Algebraic identities",
      "prompt": "Which identities turn squares into easy arithmetic?",
      "formula": "(a + b)² = a² + 2ab + b²\n(a − b)² = a² − 2ab + b²\na² − b² = (a − b)(a + b)",
      "variables": [],
      "explanation": "The difference of squares replaces two big squares with one easy product.",
      "example": "105² − 95² = (105 − 95)(105 + 95) = 10 × 200 = 2,000",
      "commonMistake": "Forgetting the middle term 2ab when expanding a square.",
      "applicationPrompt": "Find 105² − 95² without squaring.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "sp-multiply-f",
      "topicId": "simplification",
      "conceptId": "sp-shortcuts",
      "kind": "shortcut",
      "title": "Friendly multipliers",
      "prompt": "How can you multiply quickly by 5, 25, 125 or 99?",
      "formula": "× 5 = × 10 ÷ 2\n× 25 = × 100 ÷ 4\n× 125 = × 1000 ÷ 8\n× 99 = × 100 − × 1",
      "variables": [],
      "explanation": "Each of these is a power of ten divided by a small number, or a round number minus one.",
      "example": "125 × 88 = 88,000 ÷ 8 = 11,000",
      "commonMistake": "Shifting the decimal point the wrong way.",
      "applicationPrompt": "Compute 125 × 88 using the shortcut.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "sp-fraction-f",
      "topicId": "simplification",
      "conceptId": "sp-fractions",
      "title": "Fractions in expressions",
      "prompt": "How do you handle \"of\" and division by a fraction?",
      "formula": "a/b of N = N × a/b\nx ÷ (a/b) = x × (b/a)",
      "variables": [],
      "explanation": "\"Of\" is multiplication. Dividing by a fraction is multiplying by the reciprocal.",
      "example": "3/4 ÷ 9/16 = 3/4 × 16/9 = 4/3",
      "commonMistake": "Flipping the wrong fraction when dividing.",
      "applicationPrompt": "Simplify 3/4 ÷ 9/16.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "sp-powers-f",
      "topicId": "simplification",
      "conceptId": "sp-powers",
      "title": "Powers and roots",
      "prompt": "When are squares and roots evaluated in an expression?",
      "formula": "Powers and roots are evaluated first, like brackets\n√a × √a = a;  (√a)² = a",
      "variables": [],
      "explanation": "A power or root belongs to its base, so resolve it before the operations around it.",
      "example": "√64 + 3² − 2³ × √16 ÷ 4 = 8 + 9 − 8 × 4 ÷ 4 = 9",
      "commonMistake": "Applying the power to the whole expression.",
      "applicationPrompt": "Evaluate √64 + 3² − 2³ × √16 ÷ 4.",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "sp-sc-square-ending-5",
      "topicId": "simplification",
      "conceptId": "sp-shortcuts",
      "kind": "shortcut",
      "title": "Squaring a number ending in 5",
      "prompt": "How do you square a number that ends in 5 at sight?",
      "formula": "(n5)² = n × (n + 1), followed by 25",
      "variables": [],
      "explanation": "(10n + 5)² = 100n(n + 1) + 25.",
      "example": "65²: 6 × 7 = 42, then 25, giving 4,225.",
      "commonMistake": "Squaring the leading digit (6 × 6) instead of multiplying it by the next number.",
      "applicationPrompt": "Find 85² mentally.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    },
    {
      "id": "sp-sc-times-11",
      "topicId": "simplification",
      "conceptId": "sp-shortcuts",
      "kind": "shortcut",
      "title": "Multiplying a two-digit number by 11",
      "prompt": "What is the quick way to multiply a two-digit number by 11?",
      "formula": "ab × 11 = a | (a + b) | b\n(carry into a when a + b is 10 or more)",
      "variables": [],
      "explanation": "11 × N = 10N + N, so the middle digit is the sum of the two digits.",
      "example": "53 × 11 = 5 | 8 | 3 = 583. 78 × 11: 7 | 15 | 8 becomes 858.",
      "commonMistake": "Writing 7158 for 78 × 11 by not carrying the 1.",
      "applicationPrompt": "Find 64 × 11 mentally.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    },
    {
      "id": "sp-sc-near-100",
      "topicId": "simplification",
      "conceptId": "sp-shortcuts",
      "kind": "shortcut",
      "title": "Multiplying numbers just under 100",
      "prompt": "How do you multiply two numbers that are both a little less than 100?",
      "formula": "(100 − a)(100 − b) = (100 − a − b) | (a × b)\n(write a × b as two digits)",
      "variables": [],
      "explanation": "Expanding gives 100(100 − a − b) + ab.",
      "example": "97 × 94: deficits 3 and 6. 100 − 9 = 91, then 3 × 6 = 18, giving 9,118.",
      "commonMistake": "Writing a single digit for the product: 98 × 97 is 95 | 06 = 9,506, not 956.",
      "applicationPrompt": "Find 96 × 92 mentally.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    },
    {
      "id": "sp-sc-square-near-50",
      "topicId": "simplification",
      "conceptId": "sp-shortcuts",
      "kind": "shortcut",
      "title": "Squares near 50",
      "prompt": "How do you square a number close to 50?",
      "formula": "(50 ± a)² = (25 ± a) | a²\n(write a² as two digits)",
      "variables": [],
      "explanation": "(50 + a)² = 2,500 + 100a + a² = 100(25 + a) + a².",
      "example": "53² = 28 | 09 = 2,809. 47² = 22 | 09 = 2,209.",
      "commonMistake": "Adding a to 50 rather than to 25.",
      "applicationPrompt": "Find 56² mentally.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    }
  ],

  "questions": [
    {
      "id": "simplification-q-001",
      "topicId": "simplification",
      "conceptId": "sp-bodmas",
      "levelId": "simplification-level-2",
      "difficulty": "easy",
      "learningStage": "independent",
      "type": "single_choice",
      "question": "What is the value of 8 + 6 × 3?",
      "options": [
        {
          "id": "a",
          "text": "42"
        },
        {
          "id": "b",
          "text": "26"
        },
        {
          "id": "c",
          "text": "24"
        },
        {
          "id": "d",
          "text": "18"
        }
      ],
      "correctAnswer": [
        "b"
      ],
      "explanation": "Multiplication comes before addition: 6 × 3 = 18, and 8 + 18 = 26. Working left to right would wrongly give 14 × 3 = 42.",
      "solutionSteps": [
        "6 × 3 = 18.",
        "8 + 18 = 26."
      ],
      "formulaIds": [
        "sp-bodmas-f"
      ],
      "method": "Multiply before adding.",
      "hints": [
        {
          "level": 1,
          "text": "Which operation has priority?"
        }
      ],
      "commonMistakes": [
        "Going left to right and getting 42."
      ],
      "tags": [
        "basic",
        "trap"
      ],
      "estimatedSeconds": 25,
      "source": "original",
      "version": 1,
      "active": true
    },
    {
      "id": "simplification-q-002",
      "topicId": "simplification",
      "conceptId": "sp-bodmas",
      "levelId": "simplification-level-2",
      "difficulty": "easy",
      "learningStage": "independent",
      "type": "single_choice",
      "question": "What is the value of 48 ÷ 6 × 2?",
      "options": [
        {
          "id": "a",
          "text": "4"
        },
        {
          "id": "b",
          "text": "16"

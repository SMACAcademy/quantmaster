      "lesson": {
        "blocks": [
          {
            "type": "text",
            "title": "Why order matters",
            "body": "8 + 6 × 3 has one correct value, 26, not 42. Mathematicians agreed a fixed order so every expression means the same thing to everyone: brackets, of, division and multiplication, then addition and subtraction."
          },
          {
            "type": "formula",
            "title": "BODMAS",
            "body": "Brackets → Of → Division / Multiplication → Addition / Subtraction",
            "caption": "Division and multiplication are one level, as are addition and subtraction: work left to right within a level."

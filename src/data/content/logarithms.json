{
  "topicId": "logarithms",
  "concepts": [
    {
      "id": "lg-definition",
      "topicId": "logarithms",
      "name": "What a logarithm means",
      "description": "log_b(x) = y is just another way of writing b^y = x — a logarithm asks \"what power?\"",
      "sortOrder": 1
    },
    {
      "id": "lg-laws",
      "topicId": "logarithms",
      "name": "Laws of logarithms",
      "description": "Logarithms turn multiplication into addition, division into subtraction, and powers into multiplication.",
      "sortOrder": 2
    },
    {
      "id": "lg-changebase",
      "topicId": "logarithms",
      "name": "Change of base",
      "description": "Any logarithm can be rewritten using a different base by dividing two logarithms in that new base.",
      "sortOrder": 3
    },
    {
      "id": "lg-special",
      "topicId": "logarithms",
      "name": "Special values",
      "description": "log_b(1) is always 0 and log_b(b) is always 1, whatever the base b is.",
      "sortOrder": 4
    },
    {
      "id": "lg-solve",
      "topicId": "logarithms",
      "name": "Solving equations with logarithms",
      "description": "Logarithms undo exponents, so they let you solve for an unknown that sits in an exponent.",
      "sortOrder": 5
    }
  ],
  "formulas": [
    {
      "id": "lg-def-f",
      "topicId": "logarithms",
      "conceptId": "lg-definition",
      "title": "The meaning of a logarithm",
      "prompt": "What does log_b(x) = y mean?",
      "formula": "log_b(x) = y  ⟺  b^y = x",
      "variables": [],
      "explanation": "A logarithm answers the question \"to what power must b be raised to get x?\"",
      "example": "log_2(8) = 3, because 2³ = 8",
      "commonMistake": "Mixing up the base and the argument.",
      "applicationPrompt": "Evaluate log_2(8).",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "lg-laws-f",
      "topicId": "logarithms",
      "conceptId": "lg-laws",
      "title": "Product, quotient and power laws",
      "prompt": "How do logarithms handle multiplication, division and powers?",
      "formula": "log(mn) = log m + log n\nlog(m/n) = log m − log n\nlog(mᵏ) = k · log m",
      "variables": [],
      "explanation": "These laws let you break a complicated logarithm into simpler pieces, or combine several logarithms into one.",
      "example": "log 8 + log 5 = log 40",
      "commonMistake": "Turning log(m + n) into log m + log n — the product law only applies to multiplication, not addition.",
      "applicationPrompt": "Combine log 8 + log 5 into a single logarithm.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "lg-changebase-f",
      "topicId": "logarithms",
      "conceptId": "lg-changebase",
      "title": "Change of base formula",
      "prompt": "How do you rewrite a logarithm in a different base?",
      "formula": "log_b(a) = log_c(a) / log_c(b),  for any valid base c",
      "variables": [],
      "explanation": "This is useful when your calculator or given data only has logarithms in one particular base.",
      "example": "log_4(64) = log_2(64) / log_2(4) = 6 / 2 = 3",
      "commonMistake": "Placing the original base in the numerator instead of the denominator.",
      "applicationPrompt": "Find log_4(64) using base 2.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "lg-special-f",
      "topicId": "logarithms",
      "conceptId": "lg-special",
      "title": "Special logarithm values",
      "prompt": "What are log_b(1) and log_b(b) always equal to?",
      "formula": "log_b(1) = 0\nlog_b(b) = 1",
      "variables": [],
      "explanation": "These follow directly from the definition: b⁰ = 1 and b¹ = b, for any base b.",
      "example": "log_5(1) = 0 and log_5(5) = 1",
      "commonMistake": "Assuming log_b(1) equals b or 1 instead of 0.",
      "applicationPrompt": "Evaluate log_5(1).",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "lg-solve-f",
      "topicId": "logarithms",
      "conceptId": "lg-solve",
      "title": "Solving for an exponent",
      "prompt": "How do logarithms help solve an equation like bˣ = k?",
      "formula": "If b^x = k, then x = log_b(k)",
      "variables": [],
      "explanation": "Taking the logarithm (in any consistent base) of both sides brings the unknown exponent down where it can be isolated.",
      "example": "2ˣ = 32  →  x = log_2(32) = 5",
      "commonMistake": "Trying to isolate x without taking a logarithm of both sides first.",
      "applicationPrompt": "Solve 2ˣ = 32 for x.",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "lg-sc-digits",
      "topicId": "logarithms",
      "conceptId": "lg-laws",
      "kind": "shortcut",
      "title": "How many digits?",
      "prompt": "How many digits does a huge power have?",
      "formula": "Digits in N = ⌊log₁₀ N⌋ + 1",
      "variables": [],
      "explanation": "A number with d digits lies from 10^(d − 1) up to 10^d, so its log lies from d − 1 up to d.",
      "example": "2¹⁰⁰: log = 100 × 0.30103 = 30.1, so 31 digits.",
      "commonMistake": "Forgetting to add 1.",
      "applicationPrompt": "How many digits are there in 3⁵⁰? (log 3 ≈ 0.4771)",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    },
    {
      "id": "lg-sc-power-base",
      "topicId": "logarithms",
      "conceptId": "lg-changebase",
      "kind": "shortcut",
      "title": "Powers in the base and the number",
      "prompt": "How do you simplify log of a power to a base that is also a power?",
      "formula": "log_(bᵐ) (aⁿ) = (n ÷ m) × log_b a",
      "variables": [],
      "explanation": "Bring the power of the number down as a multiplier, and the power of the base down as a divisor.",
      "example": "log₈ 32 = log_(2³) 2⁵ = 5/3.",
      "commonMistake": "Multiplying by m instead of dividing.",
      "applicationPrompt": "Find log₂₇ 81.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    },
    {
      "id": "lg-sc-values",
      "topicId": "logarithms",
      "conceptId": "lg-special",
      "kind": "shortcut",
      "title": "Logs worth knowing",
      "prompt": "Which common logarithms let you build most others?",
      "formula": "log 2 ≈ 0.3010   log 3 ≈ 0.4771\nlog 5 = 1 − log 2 ≈ 0.6990   log 7 ≈ 0.8451",
      "variables": [],
      "explanation": "Every whole number up to 10 is a product of 2, 3, 5 and 7, so its log is a sum of these.",
      "example": "log 6 = log 2 + log 3 ≈ 0.7781. log 0.125 = −3 log 2 ≈ −0.9031.",
      "commonMistake": "Writing log 5 = log 10 ÷ log 2 instead of log 10 − log 2.",
      "applicationPrompt": "Find log 72 using log 2 and log 3.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    }
  ],

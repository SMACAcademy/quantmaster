      "id": "ae-terms",
      "topicId": "algebraic-expressions",
      "name": "Terms and like terms",
      "description": "A term is a number, a variable, or a product/quotient of them; like terms have the same variables raised to the same powers.",
      "sortOrder": 1
    },
    {
      "id": "ae-simplify",
      "topicId": "algebraic-expressions",
      "name": "Combining like terms",
      "description": "Add or subtract the coefficients of like terms; unlike terms cannot be combined.",
      "sortOrder": 2
    },
    {
      "id": "ae-expand",
      "topicId": "algebraic-expressions",
      "name": "Expanding brackets",
      "description": "Multiply every term inside a bracket by whatever sits outside it, keeping signs.",
      "sortOrder": 3
    },
    {
      "id": "ae-factorise",
      "topicId": "algebraic-expressions",
      "name": "Factorising",
      "description": "Pull out the highest common factor from every term, or split a sum to match a known identity.",
      "sortOrder": 4
    },
    {
      "id": "ae-substitute",
      "topicId": "algebraic-expressions",
      "name": "Substitution",

  "formulas": [
    {
      "id": "ae-liketerms-f",
      "topicId": "algebraic-expressions",
      "conceptId": "ae-simplify",
      "title": "Combining like terms",
      "prompt": "How do you simplify an expression with several like terms?",
      "formula": "ax + bx = (a + b)x\nax² + bx² = (a + b)x²",
      "variables": [],
      "explanation": "Only the coefficients of matching variable parts add; the variable part itself never changes.",
      "example": "3x + 5x − 2x = 6x",
      "commonMistake": "Combining terms with different variable parts, such as 3x and 5x².",
      "applicationPrompt": "Simplify 3x + 5x − 2x.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ae-distribute-f",
      "topicId": "algebraic-expressions",
      "conceptId": "ae-expand",
      "title": "Distributive law",
      "prompt": "How do you expand a(b + c)?",
      "formula": "a(b + c) = ab + ac\n−a(b − c) = −ab + ac",
      "variables": [],
      "explanation": "Every term inside the bracket is multiplied by the term outside, and the sign outside flips the sign of each term when it is negative.",
      "example": "3(2x − 5) = 6x − 15",
      "commonMistake": "Multiplying only the first term inside the bracket.",
      "applicationPrompt": "Expand 3(2x − 5).",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ae-hcf-f",
      "topicId": "algebraic-expressions",
      "conceptId": "ae-factorise",
      "title": "Factorising by HCF",
      "prompt": "How do you factorise an expression like 6x² + 9x?",
      "formula": "Take out the HCF of the coefficients and the lowest power of each variable common to every term",
      "variables": [],
      "explanation": "Every term must be divisible by whatever is factored out; check by expanding back.",
      "example": "6x² + 9x = 3x(2x + 3)",
      "commonMistake": "Taking out a factor that does not divide every term.",
      "applicationPrompt": "Factorise 6x² + 9x.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ae-identity-f",
      "topicId": "algebraic-expressions",
      "conceptId": "ae-factorise",
      "title": "Standard identities",
      "prompt": "Which identities help factorise or expand quickly?",
      "formula": "(a + b)² = a² + 2ab + b²\n(a − b)² = a² − 2ab + b²\na² − b² = (a + b)(a − b)",
      "variables": [],
      "explanation": "Recognising these patterns turns a multi-step expansion or factorisation into one step.",
      "example": "x² − 49 = (x + 7)(x − 7)",
      "commonMistake": "Forgetting the middle term 2ab, or treating a² − b² as (a − b)².",
      "applicationPrompt": "Factorise x² − 49.",
      "tags": [
        "core"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ae-substitute-f",
      "topicId": "algebraic-expressions",
      "conceptId": "ae-substitute",
      "title": "Substitution",
      "prompt": "How do you evaluate an expression for given variable values?",
      "formula": "Replace each variable with its value, then apply BODMAS",
      "variables": [],
      "explanation": "Substitute first, keeping negative values in brackets, then simplify using the normal order of operations.",
      "example": "For x = −2: 3x² + 4x = 3(−2)² + 4(−2) = 12 − 8 = 4",
      "commonMistake": "Forgetting to square the whole negative value, computing −2² as −4.",
      "applicationPrompt": "Evaluate 3x² + 4x for x = −2.",
      "tags": [
        "core"
      ],
      "difficulty": "medium"
    },
    {
      "id": "ae-sc-check-value",
      "topicId": "algebraic-expressions",
      "conceptId": "ae-expand",
      "kind": "shortcut",
      "title": "Check an expansion with a number",
      "prompt": "How can you check an expansion or simplification in a few seconds?",
      "formula": "Put x = 1 (or 2) into both sides.\nDifferent values mean the algebra is wrong.",
      "variables": [],
      "explanation": "Two expressions that are equal must give the same value for every x, so one quick substitution catches most slips.",
      "example": "Is (x + 3)² = x² + 9? At x = 1: 16 against 10, so no. The correct x² + 6x + 9 also gives 16.",
      "commonMistake": "Testing with x = 0, which hides any mistake in the x terms.",
      "applicationPrompt": "Check whether (2x − 1)(x + 4) = 2x² + 7x − 4.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "easy"
    },
    {
      "id": "ae-sc-coefficient-sum",
      "topicId": "algebraic-expressions",
      "conceptId": "ae-substitute",
      "kind": "shortcut",
      "title": "Sum of the coefficients",
      "prompt": "How do you find the sum of all the coefficients of a long expansion without expanding it?",
      "formula": "Sum of coefficients = value at x = 1",
      "variables": [],
      "explanation": "At x = 1 every power of x is 1, so only the coefficients are left to add.",
      "example": "(2x − 1)⁵: sum of coefficients = (2 − 1)⁵ = 1 (the expansion is 32, −80, 80, −40, 10, −1).",
      "commonMistake": "Forgetting the constant term, which is also a coefficient.",
      "applicationPrompt": "Find the sum of the coefficients of (3x − 2)⁴.",
      "tags": [
        "shortcut"
      ],
      "difficulty": "medium"
    }
  ],

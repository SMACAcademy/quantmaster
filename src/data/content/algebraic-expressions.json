    {
      "id": "algebraic-expressions-q-006",
      "topicId": "algebraic-expressions",
      "conceptId": "ae-factorise",
      "levelId": "algebraic-expressions-level-3",
      "difficulty": "medium",
      "learningStage": "guided",
      "type": "single_choice",
      "question": "What is the factorised form of 6x² + 9x?",
      "options": [
        {
          "id": "a",
          "text": "3(2x² + 3x)"
        },
        {
          "id": "b",
          "text": "3x(2x + 3)"
        },
        {
          "id": "c",
          "text": "x(6x + 9)"
        },
        {
          "id": "d",
          "text": "3x(2x + 9)"
        }
      ],
      "correctAnswer": [
        "b"
      ],
      "explanation": "The HCF of 6x² and 9x is 3x. Dividing each term by 3x gives 2x and 3, so the factorised form is 3x(2x + 3).",
      "solutionSteps": [
        "HCF = 3x.",
        "6x² ÷ 3x = 2x; 9x ÷ 3x = 3.",
        "Result: 3x(2x + 3)."
      ],
      "formulaIds": [
        "ae-hcf-f"
      ],
      "method": "Divide each term by the HCF.",
      "hints": [
        {
          "level": 1,
          "text": "Find the HCF of the coefficients and the variable parts."

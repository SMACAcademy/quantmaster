      "levelId": "algebraic-expressions-level-3",
      "difficulty": "medium",
      "learningStage": "guided",
      "type": "single_choice",
      "question": "What is x² − 49 factorised?",
      "options": [
        {
          "id": "a",
          "text": "(x − 7)²"
        },
        {
          "id": "b",
          "text": "(x + 7)(x − 7)"
        },
        {
          "id": "c",
          "text": "(x + 49)(x − 1)"
        },
        {
          "id": "d",
          "text": "(x − 7)(x − 7)"
        }
      ],
      "correctAnswer": [
        "b"
      ],
      "explanation": "This is a difference of squares: x² − 49 = x² − 7² = (x + 7)(x − 7).",
      "solutionSteps": [
        "49 = 7².",
        "a² − b² = (a + b)(a − b).",
        "Result: (x + 7)(x − 7)."
      ],
      "formulaIds": [
        "ae-identity-f"
      ],
      "method": "Recognise the difference-of-squares pattern.",
      "hints": [
        {
          "level": 1,
          "text": "49 is a perfect square."
        }
      ],
      "commonMistakes": [
        "Writing (x − 7)², which loses the cross term."
      ],
      "tags": [
        "two-step"
      ],
      "estimatedSeconds": 40,

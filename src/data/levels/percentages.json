    {
      "id": "percentages-level-12",
      "topicId": "percentages",
      "order": 12,
      "title": "Advanced: Stocks and Shares",
      "description": "Income and yield from stock, choosing the better stock, and brokerage when buying, selling and switching.",
      "type": "concept",
      "difficulty": "complex",
      "estimatedMinutes": 10,
      "prerequisiteLevelIds": [
        "percentages-level-11"
      ],
      "conceptIds": [
        "pct-adv-stocks",
        "pct-adv-invest"
      ],
      "xpReward": 40,
      "lesson": {
        "blocks": [
          {
            "type": "text",
            "title": "Face value and market value",
            "body": "Stock has a face value, usually ₹100, and a market value: the price it trades at today. It is at a premium when the market value is above ₹100 (₹120 is a premium of ₹20), at a discount when below (₹90 is a discount of ₹10), and at par at exactly ₹100.\n\nThe dividend is always paid on the face value, whatever you paid for the stock."
          },
          {
            "type": "example",
            "title": "Reading \"10% stock at ₹125\"",
            "body": "₹100 of stock costs ₹125\nand pays ₹10 every year.\n\n₹5,000 invested\n= 5,000 ÷ 125 = 40 units\n= ₹4,000 of stock\nIncome = 40 × ₹10 = ₹400"
          },
          {
            "type": "formula",
            "title": "Income from stock",
            "body": "Income = (Investment ÷ Market price) × Dividend per ₹100 stock",
            "caption": "Investment ÷ market price counts the ₹100 units you own; each unit pays the dividend."
          },
          {
            "type": "check",
            "questionId": "percentages-pct-adv-q-001"
          },
          {
            "type": "formula",
            "title": "Rate of return (yield)",
            "body": "Yield = Dividend ÷ Market price × 100",
            "caption": "Bought at a premium, the yield is below the printed rate; at a discount, above it."
          },
          {
            "type": "check",
            "questionId": "percentages-pct-adv-q-002"
          },
          {
            "type": "text",
            "title": "Which stock is better?",
            "body": "Compare yields, not printed rates. 8% stock at ₹96 yields 8⅓%, while 10% stock at ₹125 yields only 8%, so the 8% stock is the better buy.\n\nTo skip the division, cross-multiply: 8 × 125 = 1,000 beats 10 × 96 = 960."
          },
          {
            "type": "text",
            "title": "Brokerage",
            "body": "Brokerage is charged on every ₹100 of stock. When you buy, add it to the price; when you sell, take it off. With stock at ₹120 and ₹1 brokerage, a unit costs ₹121 to buy and fetches ₹119 on sale."
          },
          {
            "type": "callout",
            "tone": "tip",
            "body": "For a switch from one stock to another, work in ₹100 units throughout: old units → sale money → new units → new income. Compare the two incomes at the end."
          }
        ]
      }

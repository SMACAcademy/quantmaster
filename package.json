{
  "name": "quantmaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QuantMaster: free, open, offline quantitative aptitude and logical reasoning practice. No accounts, no server.",
  "license": "MIT",
  "homepage": "https://smacacademy.github.io/quantmaster/",
  "repository": {
    "type": "git",
    "url": "https://github.com/SMACAcademy/quantmaster.git"
  },
  "bugs": {
    "url": "https://github.com/SMACAcademy/quantmaster/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate-data": "node scripts/validate-data.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run validate-data && npm run test && npm run build",
    "check:full": "npm run check && npm run test:e2e",
    "content:export": "node scripts/content-sheet.js export",
    "content:import": "node scripts/content-sheet.js import",
    "content:template": "node scripts/content-sheet.js template"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "exceljs": "^4.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
